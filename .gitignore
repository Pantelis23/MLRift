# Build artifacts
/build/*
!/build/krc2
/dist/
/target/

# Compiled output
*.krbo
*.mlrbo
*.elf
*.o
*.a
a.out

# living-compiler (`mlrc lc --fix`) verification scratch.
# Most of it lands under build/, which is already ignored. The staged rewrite
# has to stay a SIBLING of the file being migrated when that file is compiled
# directly as its own build unit, because `import "x.mlr"` resolves relative
# to the importing file's directory — so for src/ and std/ it cannot be moved.
# There is no portable delete builtin, so these are truncated to zero bytes
# rather than removed; ignoring them keeps a blind `git add -A` from sweeping
# empty scratch into a commit.
*.lcverify.mlr
*.lcunit_a.mlr
*.lcunit_b.mlr
# tests/run_tests.sh stages a byte copy of std/hip.mlr here to prove the
# @dynamic module verifies in-process. It is rm -f'd on the normal path, but
# an interrupted suite leaves it inside TRACKED std/ -- and none of the three
# patterns above matches it.
lc_dynprobe_*.mlr

# Test artifacts (root-level only — build/mlrc is the committed bootstrap)
/test_input.mlr
/test_input.kr
/mlrc2
/mlrc3
/mlrc4
/krc2
/krc3
/krc4

# HIP / hipcc intermediate artifacts (regenerated per compile)
*-hip-amdgcn-amd-amdhsa-gfx*.bc
*-hip-amdgcn-amd-amdhsa-gfx*.hipi
*-hip-amdgcn-amd-amdhsa-gfx*.s
*-hip-amdgcn-amd-amdhsa-gfx*.o
*-hip-amdgcn-amd-amdhsa-gfx*.out
*-hip-amdgcn-amd-amdhsa-gfx*.out.resolution.txt

