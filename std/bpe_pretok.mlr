// MLRift Standard Library — the exact GPT-2 ByteLevel pre-tokenizer.
//
// Split out of std/bpe_train.mlr so the two callers can share it without
// sharing the trainer's dependencies: std/tokenizer.mlr is on the LLM
// inference path (~15 drivers import it) and must not pull in
// std/thread.mlr's raw clone()/futex pool, which bpe_train.mlr needs for
// its parallel word counter. This module is a leaf: io.mlr for print/exit
// and bpe_unicode.mlr for the \p{L} / \p{N} tables, nothing else.
//
// The split is a pure move — the code below is byte-for-byte what
// bpe_train.mlr carried, verified against live HF tokenizers 0.23.1 on
// ~5 400 fuzz cases and 14 goldens (tests/bpe/pretok_smoke.mlr,
// tests/bpe/golden/, scripts/bpe_verify.sh). It reproduces the GPT-2 /
// plain-ByteLevel regex ONLY:
//
//   's|'t|'re|'ve|'m|'ll|'d | ?\p{L}+ | ?\p{N}+ | ?[^\s\p{L}\p{N}]+ | \s+(?!\S) | \s+
//
// It is NOT the llama-bpe / qwen2 regex (`\p{N}{1,3}`, the
// `[^\r\n\p{L}\p{N}]?\p{L}+` fold, `\s*[\r\n]+`) — see the encode-path
// note in std/tokenizer.mlr for which loaded tokenizers get which.

import "io.mlr"
import "bpe_unicode.mlr"

static u64 bpe_b2c = 0        // u32[256] byte -> codepoint
static u64 bpe_b2c_init = 0

fn bpe_b2c_ensure() {
    if bpe_b2c_init == 1 { return }
    bpe_b2c = alloc(256 * 4)
    u64 b = 0
    u64 n = 0                 // counter for the "other" remap into 0x100+
    while b < 256 {
        // printable set: 0x21..0x7E, 0xA1..0xAC, 0xAE..0xFF map to themselves
        u64 printable = 0
        if b >= 0x21 && b <= 0x7E { printable = 1 }
        if b >= 0xA1 && b <= 0xAC { printable = 1 }
        if b >= 0xAE && b <= 0xFF { printable = 1 }
        u32 cp = 0
        if printable == 1 { cp = b } else { cp = 0x100 + n; n = n + 1 }
        store32(bpe_b2c + b*4, cp)
        b = b + 1
    }
    bpe_b2c_init = 1
}

fn bpe_utf8_encode_cp(u64 dst, u64 cp) -> u64 {
    if cp < 0x80 { store8(dst, cp); return 1 }
    if cp < 0x800 {
        store8(dst,   0xC0 | (cp >> 6))
        store8(dst+1, 0x80 | (cp & 0x3F)); return 2 }
    if cp < 0x10000 {
        store8(dst,   0xE0 | (cp >> 12))
        store8(dst+1, 0x80 | ((cp >> 6) & 0x3F))
        store8(dst+2, 0x80 | (cp & 0x3F)); return 3 }
    store8(dst,   0xF0 | (cp >> 18))
    store8(dst+1, 0x80 | ((cp >> 12) & 0x3F))
    store8(dst+2, 0x80 | ((cp >> 6) & 0x3F))
    store8(dst+3, 0x80 | (cp & 0x3F)); return 4
}

fn bpe_byte_map_piece(u64 src, u64 slen, u64 dst) -> u64 {
    bpe_b2c_ensure()
    u64 i = 0; u64 o = 0
    while i < slen {
        u64 bb = 0; unsafe { *((src + i) as u8) -> bb }      // zero-extend load
        u64 cp = 0; unsafe { *((bpe_b2c + bb*4) as u32) -> cp }
        o = o + bpe_utf8_encode_cp(dst + o, cp)
        i = i + 1
    }
    return o
}

// NOTE: NO `expr as uNN` value casts anywhere — they do not parse in MLRift
// (`(b as u64)` is a parse error). Load bytes straight into u64 locals with a
// typed unsafe load (zero-extends), which is the in-tree idiom.
fn bpe_utf8_decode(u64 p, u64 end, u64 out_cp) -> u64 {
    if p >= end { return 0 }
    u64 c0 = 0; unsafe { *(p as u8) -> c0 }
    if c0 < 0x80 { store64(out_cp, c0); return 1 }
    // R-T1: stray continuation byte (0x80-0xBF) or an overlong/invalid lead
    // (0xC0-0xC1, which can only ever overlong-encode 0x00-0x7F) — lenient
    // single-byte fallback so offsets stay sane on malformed input instead
    // of silently mis-decoding/mis-splitting. Never hit on valid UTF-8.
    if c0 <= 0xC1 { store64(out_cp, c0); return 1 }
    if c0 >= 0xF0 {
        if p + 4 > end { store64(out_cp, c0); return 1 }
        u64 b1=0; u64 b2=0; u64 b3=0
        unsafe { *((p+1) as u8) -> b1 } unsafe { *((p+2) as u8) -> b2 } unsafe { *((p+3) as u8) -> b3 }
        if b1 < 0x80 || b1 > 0xBF || b2 < 0x80 || b2 > 0xBF || b3 < 0x80 || b3 > 0xBF {
            store64(out_cp, c0); return 1 }
        u64 cp = ((c0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
        store64(out_cp, cp); return 4 }
    if c0 >= 0xE0 {
        if p + 3 > end { store64(out_cp, c0); return 1 }
        u64 b1=0; u64 b2=0
        unsafe { *((p+1) as u8) -> b1 } unsafe { *((p+2) as u8) -> b2 }
        if b1 < 0x80 || b1 > 0xBF || b2 < 0x80 || b2 > 0xBF {
            store64(out_cp, c0); return 1 }
        u64 cp = ((c0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
        store64(out_cp, cp); return 3 }
    // remaining range is 0xC2..0xDF: a valid 2-byte lead.
    if p + 2 > end { store64(out_cp, c0); return 1 }
    u64 b1=0; unsafe { *((p+1) as u8) -> b1 }
    if b1 < 0x80 || b1 > 0xBF { store64(out_cp, c0); return 1 }
    u64 cp = ((c0 & 0x1F) << 6) | (b1 & 0x3F)
    store64(out_cp, cp); return 2
}

// ---------------------------------------------------------------------------
// Exact GPT-2 ByteLevel pre-tokenizer
//
//   's|'t|'re|'ve|'m|'ll|'d | ?\p{L}+ | ?\p{N}+ | ?[^\s\p{L}\p{N}]+ | \s+(?!\S) | \s+
//
// matched leftmost with ORDERED alternation at every cursor position.
//
// ORDER MATTERS: the RAW (decoded UTF-8) text is split FIRST and each piece is
// byte-mapped afterwards by the caller. Splitting byte-mapped text is wrong —
// the map turns 0xA9 into "©" (a symbol), which would tear "café" in two.
// ---------------------------------------------------------------------------

// \p{White_Space}
fn bpe_cp_is_ws(u64 cp) -> u64 {
    if cp == 0x20 { return 1 }
    if cp >= 0x09 && cp <= 0x0D { return 1 }
    if cp == 0x85 || cp == 0xA0 || cp == 0x1680 { return 1 }
    if cp >= 0x2000 && cp <= 0x200A { return 1 }
    if cp == 0x2028 || cp == 0x2029 || cp == 0x202F || cp == 0x205F || cp == 0x3000 { return 1 }
    return 0
}

// Fills offs[i]/lens[i] with each pre-token's offset+length in the ORIGINAL
// bytes of `text`; returns the piece count.
//
// `cpbuf` is an 8-byte scratch slot the CALLER owns, used for
// bpe_utf8_decode's one-codepoint output. It is a parameter, not a global,
// for thread safety (Task 6a): std/thread.mlr's workers are clone()d with
// CLONE_VM, so they share one address space, and this slot is written and
// read back once per decoded codepoint. A process-global slot would let two
// concurrent splits interleave that store/load pair and silently swap
// codepoints — a wrong character class, a wrong split boundary, and wrong
// word counts, nondeterministically and with no crash. It is a parameter
// rather than a per-call alloc() because bpe_count_words_1t calls this once
// per corpus LINE (millions of times on a real corpus), and an alloc/dealloc
// pair there costs more than the whole split.
//
// The caller must give each concurrently-running split its own slot;
// bpe_count_words_1t allocates one alongside its other scratch, so every
// bpe_wc_worker automatically gets a private one.
fn bpe_pretok_split(u64 text, u64 len, u64 offs, u64 lens, u64 max, u64 cpbuf) -> u64 {
    u64 pos = 0
    u64 np = 0
    while pos < len {
        u64 start = pos
        u64 c = 0
        unsafe { *((text + pos) as u8) -> c }
        u64 matched = 0

        // --- contractions: tried ONLY at a bare ' (no leading space), lowercase
        if c == 0x27 {
            u64 n1 = 0
            u64 has1 = 0
            if pos + 1 < len {
                unsafe { *((text + pos + 1) as u8) -> n1 }
                has1 = 1
            }
            u64 n2 = 0
            u64 has2 = 0
            if pos + 2 < len {
                unsafe { *((text + pos + 2) as u8) -> n2 }
                has2 = 1
            }
            // 2-byte: 's 't 'm 'd
            if has1 == 1 && (n1 == 0x73 || n1 == 0x74 || n1 == 0x6D || n1 == 0x64) {
                pos = pos + 2
                matched = 1
            }
            // 3-byte: 're 've 'll — BOTH trailing bytes must match
            if matched == 0 && has2 == 1 {
                if n1 == 0x72 && n2 == 0x65 {
                    pos = pos + 3
                    matched = 1
                }
                if n1 == 0x76 && n2 == 0x65 {
                    pos = pos + 3
                    matched = 1
                }
                if n1 == 0x6C && n2 == 0x6C {
                    pos = pos + 3
                    matched = 1
                }
            }
            // no match (e.g. "'r", a trailing ') → branch C eats the bare '
        }

        if matched == 0 {
            u64 cp0 = 0
            bpe_utf8_decode(text + pos, text + len, cpbuf)
            unsafe { *(cpbuf as u64) -> cp0 }

            // exactly ONE optional leading 0x20 (no other whitespace attaches)
            u64 lead_space = 0
            if cp0 == 0x20 { lead_space = 1 }

            // class the codepoint AFTER the optional space. have1 == 0 means
            // "there is no codepoint there" (EOF) — kept distinct from cp == 0.
            u64 cp1 = cp0
            u64 first = pos
            u64 have1 = 1
            if lead_space == 1 {
                first = pos + 1
                if first < len {
                    bpe_utf8_decode(text + first, text + len, cpbuf)
                    unsafe { *(cpbuf as u64) -> cp1 }
                } else {
                    have1 = 0
                }
            }

            // Branch A: ` ?\p{L}+`
            if have1 == 1 && uni_is_letter(cp1) == 1 {
                pos = first
                while pos < len {
                    u64 cpa = 0
                    u64 ua = bpe_utf8_decode(text + pos, text + len, cpbuf)
                    unsafe { *(cpbuf as u64) -> cpa }
                    if uni_is_letter(cpa) == 1 { pos = pos + ua } else { break }
                }
                matched = 1
            }

            // Branch B: ` ?\p{N}+`
            if matched == 0 && have1 == 1 && uni_is_number(cp1) == 1 {
                pos = first
                while pos < len {
                    u64 cpb = 0
                    u64 ub = bpe_utf8_decode(text + pos, text + len, cpbuf)
                    unsafe { *(cpbuf as u64) -> cpb }
                    if uni_is_number(cpb) == 1 { pos = pos + ub } else { break }
                }
                matched = 1
            }

            // Branch C: ` ?[^\s\p{L}\p{N}]+`
            if matched == 0 && have1 == 1 && bpe_cp_is_ws(cp1) == 0 && uni_is_letter(cp1) == 0 && uni_is_number(cp1) == 0 {
                pos = first
                while pos < len {
                    u64 cpc = 0
                    u64 uc = bpe_utf8_decode(text + pos, text + len, cpbuf)
                    unsafe { *(cpbuf as u64) -> cpc }
                    if bpe_cp_is_ws(cpc) == 0 && uni_is_letter(cpc) == 0 && uni_is_number(cpc) == 0 {
                        pos = pos + uc
                    } else {
                        break
                    }
                }
                matched = 1
            }

            // Branch D/E: `\s+(?!\S)` then `\s+`
            if matched == 0 && bpe_cp_is_ws(cp0) == 1 {
                u64 runend = pos
                while runend < len {
                    u64 cpd = 0
                    u64 ud = bpe_utf8_decode(text + runend, text + len, cpbuf)
                    unsafe { *(cpbuf as u64) -> cpd }
                    if bpe_cp_is_ws(cpd) == 1 { runend = runend + ud } else { break }
                }
                if runend < len {
                    // a non-space follows: \s+(?!\S) takes all but the LAST
                    // whitespace codepoint; that one leads the next token.
                    u64 prev = pos
                    u64 q = pos
                    while q < runend {
                        u64 uq = bpe_utf8_decode(text + q, text + len, cpbuf)
                        prev = q
                        q = q + uq
                    }
                    if prev > pos { pos = prev } else { pos = runend }
                } else {
                    // the run reaches EOF: plain \s+ takes the whole run
                    pos = runend
                }
                matched = 1
            }
        }

        if pos <= start { pos = start + 1 }        // safety: never stall
        if np >= max {
            print("bpe_pretok_split: piece overflow\n")
            exit(1)
        }
        store64(offs + np * 8, start)
        store64(lens + np * 8, pos - start)
        np = np + 1
    }
    // cpbuf is caller-owned scratch — do NOT dealloc it here.
    return np
}
