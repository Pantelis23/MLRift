// MLRift — built on KernRift — Analysis Passes
//
// Implements kernel safety checks:
//   1. Context check (ctx): verify caller/callee context compatibility
//   2. Effect check (eff): verify declared effects match actual operations
//   3. Lock graph: detect potential deadlocks via lock ordering
//   4. Capability check (caps): verify module capability declarations
//   5. Critical region: no alloc/block inside critical sections
//   6. Unsafe pointer check: track raw pointer usage

// ---------------------------------------------------------------------------
// Annotation storage
// ---------------------------------------------------------------------------
// Each function can have annotations: @ctx(...), @eff(...), @caps(...)
// Store as: [fn_tok(4), ann_type(4), ann_data(8)] × 4096

static uint64 ann_table = 0
static uint64 ann_count = 0

// Semantic validation statics
static uint64 fn_sig_table = 0
static uint64 fn_sig_count = 0
static uint64 sema_errors = 0
static uint64 sema_source = 0
static uint64 sema_tok_buf = 0

// Diagnostic collection
static uint64 diag_table = 0
static uint64 diag_count = 0
static uint64 diag_error_count = 0
static uint64 diag_warn_count = 0

// Annotation types
// 0 = ctx (context: task, irq, nmi, any)
// 1 = eff (effect: io, alloc, block, net, fs, none)
// 2 = caps (capability: mmio, dma, irq, port_io, sched)
// 3 = export

@export
fn analysis_init() {
    ann_table = alloc(4096 * 16)
    ann_count = 0
}

fn ann_register(uint64 fn_tok, uint64 ann_type, uint64 ann_data) {
    uint64 entry = ann_table + ann_count * 16
    uint32 ft = fn_tok
    unsafe { *(entry as uint32) = ft }
    uint64 e4 = entry + 4
    uint32 atype = ann_type
    unsafe { *(e4 as uint32) = atype }
    uint64 e8 = entry + 8
    unsafe { *(e8 as uint64) = ann_data }
    ann_count = ann_count + 1
}

fn ann_lookup(uint64 fn_tok, uint64 ann_type) -> uint64 {
    uint64 i = 0
    while i < ann_count {
        uint64 entry = ann_table + i * 16
        uint32 stored_fn = 0
        unsafe { *(entry as uint32) -> stored_fn }
        uint64 wfn = stored_fn
        if tok_text_eq(wfn, fn_tok) != 0 {
            uint64 e4 = entry + 4
            uint32 stored_type = 0
            unsafe { *(e4 as uint32) -> stored_type }
            uint64 wt = stored_type
            if wt == ann_type {
                uint64 e8 = entry + 8
                uint64 data = 0
                unsafe { *(e8 as uint64) -> data }
                return data
            }
        }
        i = i + 1
    }
    return 0xFFFFFFFF
}

// ---------------------------------------------------------------------------
// Context check
// ---------------------------------------------------------------------------
// Context hierarchy: nmi > irq > task > any
// Rule: caller ctx must be subset of callee ctx
// If a function is @ctx(irq), it cannot call @ctx(task) functions
// Context values: 0=any, 1=task, 2=irq, 3=nmi

static uint64 ctx_errors = 0

@export
fn check_ctx(uint64 root) {
    ctx_errors = 0
    // Walk all functions, check each call site
    uint32 child = ast_child(root)
    uint64 wchild = child
    while wchild != 0 {
        uint32 ck = ast_kind(wchild)
        if ck == 2 {
            uint32 fn_tok = ast_data1(wchild)
            uint64 caller_ctx = ann_lookup(fn_tok, 0)
            if caller_ctx == 0xFFFFFFFF { caller_ctx = 0 }
            // Walk function body for calls
            uint32 body = ast_data3(wchild)
            uint64 wbody = body
            if wbody != 0 {
                check_ctx_block(wbody, fn_tok, caller_ctx)
            }
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

fn check_ctx_block(uint64 block_node, uint64 caller_tok, uint64 caller_ctx) {
    uint32 child = ast_child(block_node)
    uint64 wchild = child
    while wchild != 0 {
        check_ctx_stmt(wchild, caller_tok, caller_ctx)
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

fn check_ctx_stmt(uint64 node, uint64 caller_tok, uint64 caller_ctx) {
    uint32 kind = ast_kind(node)
    // Expression statement containing a call
    if kind == 16 {
        uint32 expr = ast_child(node)
        uint64 wexpr = expr
        check_ctx_expr(wexpr, caller_tok, caller_ctx)
    }
    // If statement: check both branches
    if kind == 13 {
        uint32 then_body = ast_data1(node)
        uint64 wt = then_body
        if wt != 0 { check_ctx_block(wt, caller_tok, caller_ctx) }
        uint32 else_body = ast_data2(node)
        uint64 we = else_body
        if we != 0 {
            uint32 ek = ast_kind(we)
            if ek == 13 { check_ctx_stmt(we, caller_tok, caller_ctx) }
            else { check_ctx_block(we, caller_tok, caller_ctx) }
        }
    }
    // While: check body
    if kind == 14 {
        uint32 body = ast_data1(node)
        uint64 wb = body
        if wb != 0 { check_ctx_block(wb, caller_tok, caller_ctx) }
    }
}

fn check_ctx_expr(uint64 node, uint64 caller_tok, uint64 caller_ctx) {
    uint32 kind = ast_kind(node)
    if kind == 35 {
        // Function call: check callee context
        uint32 callee_tok = ast_data1(node)
        uint64 callee_ctx = ann_lookup(callee_tok, 0)
        if callee_ctx == 0xFFFFFFFF { callee_ctx = 0 }
        // If caller is in a restricted context (irq/nmi) and callee requires task context
        if caller_ctx > callee_ctx && callee_ctx != 0 {
            // Context violation!
            uint64 msg = "ctx-check: context violation in "
            write(2, msg, 33)
            uint64 ts = tok_text_start(caller_tok)
            uint64 tl = tok_text_len(caller_tok)
            write(2, cg_source + ts, tl)
            msg = "\n"
            write(2, msg, 1)
            ctx_errors = ctx_errors + 1
        }
    }
}

// ---------------------------------------------------------------------------
// Effect check
// ---------------------------------------------------------------------------
// Effects: io=1, alloc=2, block=4, net=8, fs=16
// Rule: function's actual effects must be subset of declared effects

static uint64 eff_errors = 0

@export
fn check_effects(uint64 root) {
    eff_errors = 0
    uint32 child = ast_child(root)
    uint64 wchild = child
    while wchild != 0 {
        uint32 ck = ast_kind(wchild)
        if ck == 2 {
            uint32 fn_tok = ast_data1(wchild)
            uint64 declared_eff = ann_lookup(fn_tok, 1)
            if declared_eff == 0xFFFFFFFF { declared_eff = 0xFFFF }
            // Compute actual effects from body
            uint32 body = ast_data3(wchild)
            uint64 wbody = body
            uint64 actual_eff = 0
            if wbody != 0 {
                actual_eff = compute_effects_block(wbody)
            }
            // Check: actual must be subset of declared
            if (actual_eff & ~declared_eff) != 0 {
                uint64 msg = "eff-check: undeclared effect in "
                write(2, msg, 33)
                uint64 ts = tok_text_start(fn_tok)
                uint64 tl = tok_text_len(fn_tok)
                write(2, cg_source + ts, tl)
                msg = "\n"
                write(2, msg, 1)
                eff_errors = eff_errors + 1
            }
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

fn compute_effects_block(uint64 block_node) -> uint64 {
    uint64 effects = 0
    uint32 child = ast_child(block_node)
    uint64 wchild = child
    while wchild != 0 {
        effects = effects | compute_effects_stmt(wchild)
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
    return effects
}

fn compute_effects_stmt(uint64 node) -> uint64 {
    uint32 kind = ast_kind(node)
    uint64 effects = 0
    if kind == 16 {
        uint32 expr = ast_child(node)
        uint64 wexpr = expr
        effects = effects | compute_effects_expr(wexpr)
    }
    if kind == 13 {
        uint32 then_body = ast_data1(node)
        uint64 wt = then_body
        if wt != 0 { effects = effects | compute_effects_block(wt) }
        uint32 else_body = ast_data2(node)
        uint64 we = else_body
        if we != 0 { effects = effects | compute_effects_block(we) }
    }
    if kind == 14 {
        uint32 body = ast_data1(node)
        uint64 wb = body
        if wb != 0 { effects = effects | compute_effects_block(wb) }
    }
    return effects
}

fn compute_effects_expr(uint64 node) -> uint64 {
    uint32 kind = ast_kind(node)
    if kind == 35 {
        uint32 callee_tok = ast_data1(node)
        // Check for known effectful builtins
        if tok_matches(callee_tok, "alloc", 5) != 0 { return 2 }
        if tok_matches(callee_tok, "write", 5) != 0 { return 1 }
        if tok_matches(callee_tok, "file_open", 9) != 0 { return 16 }
        if tok_matches(callee_tok, "file_read", 9) != 0 { return 16 }
        if tok_matches(callee_tok, "file_write", 10) != 0 { return 16 }
        // Look up callee's declared effects (transitive)
        uint64 callee_eff = ann_lookup(callee_tok, 1)
        if callee_eff != 0xFFFFFFFF { return callee_eff }
    }
    return 0
}

// ---------------------------------------------------------------------------
// Lock graph (deadlock detection)
// ---------------------------------------------------------------------------
// Track lock acquire/release patterns
// Build directed graph: if fn A holds lock X and acquires lock Y, add edge X→Y
// Detect cycles in the graph

static uint64 lock_edges = 0
static uint64 lock_edge_count = 0

@export
fn lock_graph_init() {
    lock_edges = alloc(1024 * 16)
    lock_edge_count = 0
}

fn lock_add_edge(uint64 from_tok, uint64 to_tok) {
    uint64 entry = lock_edges + lock_edge_count * 16
    uint32 ft = from_tok
    unsafe { *(entry as uint32) = ft }
    uint64 e4 = entry + 4
    uint32 tt = to_tok
    unsafe { *(e4 as uint32) = tt }
    lock_edge_count = lock_edge_count + 1
}

// Detect cycles using DFS (simplified)
@export
fn check_lock_cycles() -> uint64 {
    // For each lock, do DFS from it. If we revisit it, cycle found.
    // Simplified: just check for direct A→B and B→A pairs
    uint64 i = 0
    while i < lock_edge_count {
        uint64 entry_i = lock_edges + i * 16
        uint32 from_i = 0
        unsafe { *(entry_i as uint32) -> from_i }
        uint64 ei4 = entry_i + 4
        uint32 to_i = 0
        unsafe { *(ei4 as uint32) -> to_i }
        // Check if reverse edge exists
        uint64 j = 0
        while j < lock_edge_count {
            if j != i {
                uint64 entry_j = lock_edges + j * 16
                uint32 from_j = 0
                unsafe { *(entry_j as uint32) -> from_j }
                uint64 ej4 = entry_j + 4
                uint32 to_j = 0
                unsafe { *(ej4 as uint32) -> to_j }
                uint64 wfi = from_i
                uint64 wfj = from_j
                uint64 wti = to_i
                uint64 wtj = to_j
                if tok_text_eq(wfi, wtj) != 0 && tok_text_eq(wti, wfj) != 0 {
                    uint64 msg = "lock-cycle: potential deadlock between locks\n"
                    write(2, msg, 42)
                    return 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// Capability check
// ---------------------------------------------------------------------------
// Verify that functions only use capabilities declared in their module

static uint64 cap_errors = 0

@export
fn check_caps(uint64 root) {
    cap_errors = 0
    // Module-level caps would be declared via @caps annotation on the module
    // For now, just count how many functions use capabilities without declaring them
    uint32 child = ast_child(root)
    uint64 wchild = child
    while wchild != 0 {
        uint32 ck = ast_kind(wchild)
        if ck == 2 {
            uint32 fn_tok = ast_data1(wchild)
            uint64 fn_caps = ann_lookup(fn_tok, 2)
            // If function has unsafe blocks but no @caps declaration, warn
            // (simplified check — full version would track specific capabilities)
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

// ---------------------------------------------------------------------------
// Critical region check
// ---------------------------------------------------------------------------
// Rule: no allocation or blocking operations inside critical sections
// Critical section = between acquire() and release() calls

@export
fn check_critical_regions(uint64 root) {
    // Walk each function looking for acquire/release patterns
    // Flag any alloc/block calls between them
    uint32 child = ast_child(root)
    uint64 wchild = child
    while wchild != 0 {
        uint32 ck = ast_kind(wchild)
        if ck == 2 {
            uint32 body = ast_data3(wchild)
            uint64 wbody = body
            if wbody != 0 {
                check_critical_block(wbody, 0)
            }
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

fn check_critical_block(uint64 block_node, uint64 in_critical) -> uint64 {
    uint64 depth = in_critical
    uint32 child = ast_child(block_node)
    uint64 wchild = child
    while wchild != 0 {
        depth = check_critical_stmt(wchild, depth)
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
    return depth
}

fn check_critical_stmt(uint64 node, uint64 depth) -> uint64 {
    uint32 kind = ast_kind(node)
    if kind == 16 {
        uint32 expr = ast_child(node)
        uint64 wexpr = expr
        uint32 ek = ast_kind(wexpr)
        if ek == 35 {
            uint32 callee_tok = ast_data1(wexpr)
            if tok_matches(callee_tok, "acquire", 7) != 0 {
                return depth + 1
            }
            if tok_matches(callee_tok, "release", 7) != 0 {
                if depth > 0 { return depth - 1 }
                return 0
            }
            // Check for forbidden ops inside critical section
            if depth > 0 {
                if tok_matches(callee_tok, "alloc", 5) != 0 {
                    uint64 msg = "critical-region: alloc inside critical section\n"
                    write(2, msg, 48)
                }
            }
        }
    }
    return depth
}

// ---------------------------------------------------------------------------
// Run all analysis passes
// ---------------------------------------------------------------------------

@export
fn run_analysis(uint64 root) -> uint64 {
    analysis_init()
    lock_graph_init()
    check_ctx(root)
    check_effects(root)
    check_caps(root)
    check_critical_regions(root)
    uint64 cycle = check_lock_cycles()
    return ctx_errors + eff_errors + cycle
}

// ---------------------------------------------------------------------------
// Semantic validation — arg count, missing return, duplicate function checks
// ---------------------------------------------------------------------------

fn sema_init(uint64 source, uint64 tok_buf) {
    fn_sig_table = alloc(4096 * 16)
    fn_sig_count = 0
    if sigh_buf != 0 { memset(sigh_buf, 0, 8192 * 4) }
    sema_errors = 0
    sema_source = source
    sema_tok_buf = tok_buf
}

// Token helpers that use sema_tok_buf / sema_source

fn sema_tok_text_start(uint64 tok_idx) -> uint64 {
    uint64 p = sema_tok_buf + tok_idx * 16 + 4
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

fn sema_tok_text_len(uint64 tok_idx) -> uint64 {
    uint64 p = sema_tok_buf + tok_idx * 16 + 8
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

fn sema_tok_line(uint64 tok_idx) -> uint64 {
    uint64 p = sema_tok_buf + tok_idx * 16 + 12
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

// ---------------------------------------------------------------------------
// Diagnostic collection
// ---------------------------------------------------------------------------

fn diag_init() {
    if diag_table == 0 {
        diag_table = alloc(1024 * 8)
    }
    diag_count = 0
    diag_error_count = 0
    diag_warn_count = 0
}

// severity: 0 = error, 1 = warning
fn diag_emit(uint64 tok_idx, uint64 severity, uint64 msg_id) {
    if diag_count >= 1024 { return }
    uint64 entry = diag_table + diag_count * 8
    uint32 ti = tok_idx
    unsafe { *(entry as uint32) = ti }
    uint64 e4 = entry + 4
    uint8 sev = severity
    unsafe { *(e4 as uint8) = sev }
    uint64 e5 = entry + 5
    uint8 mid = msg_id
    unsafe { *(e5 as uint8) = mid }
    diag_count = diag_count + 1
    if severity == 0 { diag_error_count = diag_error_count + 1 }
    if severity == 1 { diag_warn_count = diag_warn_count + 1 }
}

fn diag_msg_text(uint64 msg_id) -> uint64 {
    if msg_id == 1 { return "undefined variable" }
    if msg_id == 2 { return "type mismatch" }
    if msg_id == 3 { return "redefinition of variable in same scope" }
    if msg_id == 4 { return "unused variable (prefix with _ to suppress)" }
    if msg_id == 5 { return "unreachable code after return/break/exit" }
    if msg_id == 6 { return "implicit float-to-int conversion (use f64_to_int)" }
    if msg_id == 7 { return "implicit int-to-float conversion (use int_to_f64)" }
    if msg_id == 8 { return "narrowing conversion may lose data" }
    if msg_id == 9 { return "variable used before initialization" }
    if msg_id == 10 { return "argument type mismatch" }
    if msg_id == 11 { return "return type mismatch" }
    if msg_id == 12 { return "binary operation requires matching types" }
    if msg_id == 13 { return "comparison requires matching types" }
    return "unknown diagnostic"
}

@export
fn diag_report_all() {
    uint64 i = 0
    while i < diag_count {
        uint64 entry = diag_table + i * 8
        uint32 ti = 0
        unsafe { *(entry as uint32) -> ti }
        uint64 wti = ti
        uint64 e4 = entry + 4
        uint8 sev = 0
        unsafe { *(e4 as uint8) -> sev }
        uint64 wsev = sev
        uint64 e5 = entry + 5
        uint8 mid = 0
        unsafe { *(e5 as uint8) -> mid }
        uint64 wmid = mid
        // Use sema_source for token text access
        uint64 tstart = sema_tok_text_start(wti)
        uint64 tlen = sema_tok_text_len(wti)
        // Print file:line from srcmap
        uint64 file_path = srcmap_file(tstart)
        if file_path != 0 { write(2, file_path, str_len(file_path)) }
        write(2, ":", 1)
        uint8[24] lbuf
        uint64 tok_line = sema_tok_line(wti)
        uint64 llen = fmt_uint(lbuf, tok_line)
        write(2, lbuf, llen)
        if wsev == 0 { write(2, ": error: ", 9) }
        if wsev == 1 { write(2, ": warning: ", 11) }
        uint64 msg = diag_msg_text(wmid)
        write(2, msg, str_len(msg))
        // Append variable name for relevant diagnostics
        if wmid == 1 || wmid == 3 || wmid == 4 || wmid == 9 {
            write(2, " '", 2)
            write(2, sema_source + tstart, tlen)
            write(2, "'", 1)
        }
        write(2, "\n", 1)
        i = i + 1
    }
    // Summary line
    if diag_count > 0 {
        write(2, "\n", 1)
        uint8[24] ebuf
        uint64 elen = fmt_uint(ebuf, diag_error_count)
        write(2, ebuf, elen)
        write(2, " error(s), ", 11)
        uint64 wlen = fmt_uint(ebuf, diag_warn_count)
        write(2, ebuf, wlen)
        write(2, " warning(s)\n", 12)
    }
}

// ---------------------------------------------------------------------------
// Scope stack and variable tracking (F5 Task 2)
// ---------------------------------------------------------------------------

// Scope stack: stores first_var_idx at each scope depth
static uint64 sema_scope_stack = 0
static uint64 sema_scope_depth = 0

// Variable tracking: [name_tok(4), type_id(2), flags(2)] × 4096
// flags: bit 0 = initialized, bit 1 = used, bit 2 = is_param
static uint64 sema_var_table_v = 0
static uint64 sema_var_count_v = 0

fn sema_scope_init() {
    if sema_scope_stack == 0 { sema_scope_stack = alloc(64 * 8) }
    if sema_var_table_v == 0 { sema_var_table_v = alloc(4096 * 8) }
    sema_scope_depth = 0
    sema_var_count_v = 0
}

fn sema_scope_push() {
    if sema_scope_depth >= 64 { return }
    uint64 entry = sema_scope_stack + sema_scope_depth * 8
    uint32 vc = sema_var_count_v
    unsafe { *(entry as uint32) = vc }
    sema_scope_depth = sema_scope_depth + 1
}

fn sema_scope_pop() {
    if sema_scope_depth == 0 { return }
    sema_scope_depth = sema_scope_depth - 1
    uint64 entry = sema_scope_stack + sema_scope_depth * 8
    uint32 first_var = 0
    unsafe { *(entry as uint32) -> first_var }
    uint64 wfirst = first_var
    // Check for unused variables in the popped scope
    uint64 vi = wfirst
    while vi < sema_var_count_v {
        uint64 ve = sema_var_table_v + vi * 8
        uint32 name_tok = 0
        unsafe { *(ve as uint32) -> name_tok }
        uint64 wname = name_tok
        uint64 flags_addr = ve + 6
        uint16 flags = 0
        unsafe { *(flags_addr as uint16) -> flags }
        uint64 wflags = flags
        uint64 used = wflags & 2
        // Check if name starts with '_' — suppress unused warning
        uint64 starts_underscore = 0
        uint64 nstart = sema_tok_text_start(wname)
        uint64 nch = 0
        uint64 np = sema_source + nstart
        unsafe { *(np as uint8) -> nch }
        if nch == 95 { starts_underscore = 1 }  // '_' = 95
        if used == 0 && starts_underscore == 0 {
            diag_emit(wname, 1, 4)  // warning: unused variable
        }
        vi = vi + 1
    }
    sema_var_count_v = wfirst
}

fn sema_var_declare(uint64 name_tok, uint64 type_id, uint64 is_param) {
    // Check for redeclaration in current scope
    if sema_scope_depth > 0 {
        uint64 scope_entry = sema_scope_stack + (sema_scope_depth - 1) * 8
        uint32 scope_first = 0
        unsafe { *(scope_entry as uint32) -> scope_first }
        uint64 wfirst = scope_first
        uint64 vi = wfirst
        while vi < sema_var_count_v {
            uint64 ve = sema_var_table_v + vi * 8
            uint32 existing = 0
            unsafe { *(ve as uint32) -> existing }
            uint64 we = existing
            if sema_tok_matches_tok(we, name_tok) != 0 {
                diag_emit(name_tok, 0, 3)  // error: redefinition
                return
            }
            vi = vi + 1
        }
    }
    // Register new variable
    if sema_var_count_v >= 4096 { return }
    uint64 entry = sema_var_table_v + sema_var_count_v * 8
    uint32 nt = name_tok
    unsafe { *(entry as uint32) = nt }
    uint64 tid_addr = entry + 4
    uint16 tid = type_id
    unsafe { *(tid_addr as uint16) = tid }
    uint64 flags_addr = entry + 6
    uint16 fl = 0
    if is_param != 0 { fl = 5 }  // bits 0+2 = initialized + is_param
    unsafe { *(flags_addr as uint16) = fl }
    sema_var_count_v = sema_var_count_v + 1
}

fn sema_var_lookup_v(uint64 name_tok) -> uint64 {
    // Walk backwards through all variables (inner scopes first)
    uint64 vi = sema_var_count_v
    while vi > 0 {
        vi = vi - 1
        uint64 ve = sema_var_table_v + vi * 8
        uint32 stored = 0
        unsafe { *(ve as uint32) -> stored }
        uint64 ws = stored
        if sema_tok_matches_tok(ws, name_tok) != 0 {
            return vi
        }
    }
    return 0xFFFFFFFF
}

fn sema_var_mark_used(uint64 var_idx) {
    uint64 flags_addr = sema_var_table_v + var_idx * 8 + 6
    uint16 flags = 0
    unsafe { *(flags_addr as uint16) -> flags }
    uint16 new_flags = flags | 2
    unsafe { *(flags_addr as uint16) = new_flags }
}

fn sema_var_mark_init(uint64 var_idx) {
    uint64 flags_addr = sema_var_table_v + var_idx * 8 + 6
    uint16 flags = 0
    unsafe { *(flags_addr as uint16) -> flags }
    uint16 new_flags = flags | 1
    unsafe { *(flags_addr as uint16) = new_flags }
}

fn sema_var_is_init(uint64 var_idx) -> uint64 {
    uint64 flags_addr = sema_var_table_v + var_idx * 8 + 6
    uint16 flags = 0
    unsafe { *(flags_addr as uint16) -> flags }
    uint64 wf = flags
    return wf & 1
}

fn sema_var_type_id(uint64 var_idx) -> uint64 {
    uint64 tid_addr = sema_var_table_v + var_idx * 8 + 4
    uint16 tid = 0
    unsafe { *(tid_addr as uint16) -> tid }
    return tid
}

fn sema_tok_matches_tok(uint64 tok_a, uint64 tok_b) -> uint64 {
    uint64 a_start = sema_tok_text_start(tok_a)
    uint64 a_len = sema_tok_text_len(tok_a)
    uint64 b_start = sema_tok_text_start(tok_b)
    uint64 b_len = sema_tok_text_len(tok_b)
    if a_len != b_len { return 0 }
    uint64 i = 0
    while i < a_len {
        uint64 pa = sema_source + a_start + i
        uint64 pb = sema_source + b_start + i
        uint64 ca = 0
        uint64 cb = 0
        unsafe { *(pa as uint8) -> ca }
        unsafe { *(pb as uint8) -> cb }
        if ca != cb { return 0 }
        i = i + 1
    }
    return 1
}

fn sema_tok_to_type_id(uint64 tok) -> uint64 {
    uint64 tk = sema_tok_kind(tok)
    if tk == 80 || tk == 84 { return 1 }  // u8/uint8
    if tk == 81 || tk == 85 { return 2 }  // u16/uint16
    if tk == 82 || tk == 86 { return 3 }  // u32/uint32
    if tk == 83 || tk == 87 { return 4 }  // u64/uint64
    if tk == 94 { return 5 }              // f16
    if tk == 95 { return 6 }              // f32
    if tk == 96 { return 7 }              // f64
    // Check if struct name
    if tk == 1 {
        uint64 si = struct_lookup(tok)
        if si != 0xFFFFFFFF { return 64 + si }
    }
    return 4  // default u64
}

fn sema_tok_kind(uint64 tok_idx) -> uint64 {
    uint64 p = sema_tok_buf + tok_idx * 16
    uint32 val = 0
    unsafe { *(p as uint32) -> val }
    return val
}

fn sema_tok_matches(uint64 tok_idx, uint64 target, uint64 target_len) -> uint64 {
    uint64 tlen = sema_tok_text_len(tok_idx)
    if tlen != target_len { return 0 }
    uint64 start = sema_tok_text_start(tok_idx)
    uint64 i = 0
    while i < tlen {
        uint64 sp = sema_source + start + i
        uint64 sc = 0
        unsafe { *(sp as uint8) -> sc }
        uint64 kp = target + i
        uint64 kc = 0
        unsafe { *(kp as uint8) -> kc }
        if sc != kc { return 0 }
        i = i + 1
    }
    return 1
}

fn sema_tok_text_eq(uint64 tok_a, uint64 tok_b) -> uint64 {
    uint64 la = sema_tok_text_len(tok_a)
    uint64 lb = sema_tok_text_len(tok_b)
    if la != lb { return 0 }
    uint64 sa = sema_tok_text_start(tok_a)
    uint64 sb = sema_tok_text_start(tok_b)
    uint64 i = 0
    while i < la {
        uint64 pa = sema_source + sa + i
        uint64 pb = sema_source + sb + i
        uint64 ca = 0
        uint64 cb = 0
        unsafe { *(pa as uint8) -> ca }
        unsafe { *(pb as uint8) -> cb }
        if ca != cb { return 0 }
        i = i + 1
    }
    return 1
}

// PROTOTYPE: hash index over fn_sig_table — fn_sig_lookup was a linear
// string-compare scan over every defined function, once per call site.
static uint64 sigh_buf = 0

fn sema_name_hash(uint64 name_tok) -> uint64 {
    uint64 s = sema_tok_text_start(name_tok)
    uint64 l = sema_tok_text_len(name_tok)
    uint64 p = sema_source + s
    uint64 h = 2166136261
    uint64 i = 0
    while i < l {
        uint64 c = 0
        uint64 pc2 = p + i
        unsafe { *(pc2 as uint8) -> c }
        h = (h ^ c) * 16777619
        h = h & 0xFFFFFFFF
        i = i + 1
    }
    return h & 8191
}

// Register a function signature: name_tok, param_count, has_return
fn fn_sig_register(uint64 name_tok, uint64 param_count, uint64 has_return) {
    uint64 entry = fn_sig_table + fn_sig_count * 16
    uint32 nt = name_tok
    unsafe { *(entry as uint32) = nt }
    uint64 e4 = entry + 4
    uint32 pc = param_count
    unsafe { *(e4 as uint32) = pc }
    uint64 e8 = entry + 8
    uint32 hr = has_return
    unsafe { *(e8 as uint32) = hr }
    // Insert into hash (keep-first so lookup semantics stay first-match).
    if sigh_buf == 0 {
        sigh_buf = alloc(8192 * 4)
        memset(sigh_buf, 0, 8192 * 4)
    }
    uint64 h = sema_name_hash(name_tok)
    uint64 probes = 0
    while probes < 8192 {
        uint64 sp = sigh_buf + h * 4
        uint32 sv = 0
        unsafe { *(sp as uint32) -> sv }
        if sv == 0 {
            uint32 nv = fn_sig_count + 1
            unsafe { *(sp as uint32) = nv }
            probes = 8192
        } else {
            uint64 pidx = sv
            pidx = pidx - 1
            uint64 pentry = fn_sig_table + pidx * 16
            uint32 pt32 = 0
            unsafe { *(pentry as uint32) -> pt32 }
            uint64 pt = pt32
            if sema_tok_text_eq(pt, name_tok) != 0 {
                probes = 8192
            } else {
                h = (h + 1) & 8191
                probes = probes + 1
            }
        }
    }
    fn_sig_count = fn_sig_count + 1
}

// Lookup a function signature by name. Returns param_count or 0xFFFFFFFF if not found.
fn fn_sig_lookup(uint64 name_tok) -> uint64 {
    if sigh_buf == 0 { return 0xFFFFFFFF }
    uint64 h = sema_name_hash(name_tok)
    uint64 probes = 0
    while probes < 8192 {
        uint64 sp = sigh_buf + h * 4
        uint32 sv = 0
        unsafe { *(sp as uint32) -> sv }
        if sv == 0 { return 0xFFFFFFFF }
        uint64 idx = sv
        idx = idx - 1
        uint64 entry = fn_sig_table + idx * 16
        uint32 stored_tok = 0
        unsafe { *(entry as uint32) -> stored_tok }
        uint64 wst = stored_tok
        if sema_tok_text_eq(wst, name_tok) != 0 {
            uint64 e4 = entry + 4
            uint32 pc = 0
            unsafe { *(e4 as uint32) -> pc }
            return pc
        }
        h = (h + 1) & 8191
        probes = probes + 1
    }
    return 0xFFFFFFFF
}

// ---- 32-bit scalar target (target_arch == 2 riscv32 / == 3 xtensa) restrictions ----
// RV32IMC and Xtensa LX6 are both 32-bit, integer-only targets (word size 4,
// no hardware FPU in the ported backend). Reject the 64-bit integer type kinds
// (KwUint64 = 83, KwInt64 = 87) and all float kinds (KwFloat16/32/64 =
// 94/95/96) wherever a type annotation reaches sema. No-op off those two
// arches, so x86_64/arm64 sema is byte-for-byte unchanged.
// Mirrors KernRift type_check.kr's tc_riscv32_reject_kind (KernRift has a
// dedicated type_check.kr; MLRift's sema lives here in analysis.mlr) —
// including its arch-accurate wording: saying "riscv32" when the user passed
// --arch=xtensa is baffling. Kept as ONE helper (single global namespace, no
// near-duplicate function) rather than a second analysis_xtensa_reject_kind.
fn analysis_riscv32_reject_kind(uint64 kind, uint64 tok) {
    if target_arch != 2 && target_arch != 3 { return }
    if kind == 83 || kind == 87 {
        if target_arch == 2 {
            report_error_at(tok, "64-bit integers not supported on riscv32; use uint32")
        } else {
            report_error_at(tok, "64-bit integers not supported on xtensa; use uint32")
        }
        sema_errors = sema_errors + 1
    }
    if kind >= 94 && kind <= 96 {
        if target_arch == 2 {
            report_error_at(tok, "float (f16/f32/f64) not supported on riscv32 (no hardware FPU)")
        } else {
            report_error_at(tok, "float (f16/f32/f64) not supported on xtensa (no hardware FPU)")
        }
        sema_errors = sema_errors + 1
    }
}

// Collect function signatures from top-level AST
fn sema_collect_signatures(uint64 root) {
    // Rebuild the method-name table (fn StructName.method — FnDecl data4
    // bit 6) from scratch so double invocation stays idempotent. This is
    // the always-on pre-pass that runs before any backend; codegen never
    // re-registers methods.
    fn_method_reset()
    uint32 child = ast_child(root)
    uint64 wchild = child
    while wchild != 0 {
        uint32 ck = ast_kind(wchild)
        if ck == 2 {
            // FnDecl: count params
            uint32 name_tok = ast_data1(wchild)
            uint64 wname = name_tok
            uint32 fd4_m = ast_data4(wchild)
            uint64 wfd4_m = fd4_m
            if (wfd4_m & 64) != 0 {
                fn_method_register(wname)
            }
            uint64 param_count = 0
            uint32 pchild = ast_child(wchild)
            uint64 wpchild = pchild
            while wpchild != 0 {
                uint32 pk = ast_kind(wpchild)
                if pk == 3 {
                    param_count = param_count + 1
                    // Slice params take 2 positions: ptr + len
                    uint32 pflag_sp = ast_data4(wpchild)
                    uint64 wpflag_sp = pflag_sp
                    if wpflag_sp == 1 { param_count = param_count + 1 }
                    // riscv32: reject 64-bit / float parameter types. Param
                    // node (kind 3): data1 = type token, data2 = name token.
                    uint32 ptype_tok = ast_data1(wpchild)
                    uint64 wptype_tok = ptype_tok
                    analysis_riscv32_reject_kind(sema_tok_kind(wptype_tok), wptype_tok)
                }
                uint32 pnxt = ast_next(wpchild)
                wpchild = pnxt
            }
            // riscv32: reject a 64-bit / float return type (FnDecl data2 =
            // return-type token; 0 when the function returns nothing).
            uint32 rtype_tok_rv = ast_data2(wchild)
            if rtype_tok_rv != 0 {
                uint64 wrtype_tok_rv = rtype_tok_rv
                analysis_riscv32_reject_kind(sema_tok_kind(wrtype_tok_rv), wrtype_tok_rv)
            }
            // Check for duplicate. A duplicate is fine when both decls
            // are @dynamic extern (data4 flag bits 3 + 5 set, i.e. 0x28)
            // — happens with the --target=amdgpu-native HIP-via-KFD
            // shim path where std/kfd.mlr declares puts/exit/write/etc.
            // and a launcher file (legitimately, pre-shim) re-declares
            // them locally. Both declarations name the same dlopen
            // symbol so silently dedupe instead of erroring.
            uint64 existing = fn_sig_lookup(wname)
            if existing != 0xFFFFFFFF {
                uint32 cur_flags = ast_data4(wchild)
                uint64 wcur_flags = cur_flags
                if (wcur_flags & 0x28) == 0x28 {
                    // Skip the duplicate @dynamic extern declaration.
                } else {
                    report_error_at(wname, "redefinition of function")
                    sema_errors = sema_errors + 1
                }
            } else {
                uint32 ret_tok = ast_data2(wchild)
                uint64 has_return = 0
                if ret_tok != 0 { has_return = 1 }
                fn_sig_register(wname, param_count, has_return)
            }
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

// Check if a token refers to a builtin function
fn is_builtin(uint64 tok_idx) -> uint64 {
    if sema_tok_matches(tok_idx, "exit", 4) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "print", 5) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "println", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "alloc", 5) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "dealloc", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "write", 5) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "memcpy", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "memset", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "str_len", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "str_eq", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "file_open", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "file_read", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "file_write", 10) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "file_close", 10) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "file_size", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "call_ptr", 8) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "fn_addr", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "bit_get", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "bit_set", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "bit_clear", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "bit_range", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "bit_insert", 10) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "signed_lt", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "signed_gt", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "signed_le", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "signed_ge", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "get_target_os", 13) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "get_arch_id", 11) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "time_ns", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "isb", 3) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "dsb", 3) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "dmb", 3) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "dcache_flush", 12) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "icache_invalidate", 17) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "exec_process", 12) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "exec_process_argv", 17) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "set_executable", 14) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "atomic_load", 11) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "atomic_store", 12) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "atomic_cas", 10) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "atomic_add", 10) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "atomic_sub", 10) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "atomic_and", 10) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "atomic_or", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "atomic_xor", 10) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "get_module_path", 15) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "fmt_uint", 8) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "asm", 3) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "syscall_raw", 11) != 0 { return 1 }
    // String output (null-terminated, variable pointer safe)
    if sema_tok_matches(tok_idx, "print_str", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "println_str", 11) != 0 { return 1 }
    // Easy pointer loads — zero-extended
    if sema_tok_matches(tok_idx, "load8", 5) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "load16", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "load32", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "load64", 6) != 0 { return 1 }
    // Easy pointer stores
    if sema_tok_matches(tok_idx, "store8", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "store16", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "store32", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "store64", 7) != 0 { return 1 }
    // Volatile loads — with memory barrier
    if sema_tok_matches(tok_idx, "vload8", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "vload16", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "vload32", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "vload64", 7) != 0 { return 1 }
    // Volatile stores — with memory barrier
    if sema_tok_matches(tok_idx, "vstore8", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "vstore16", 8) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "vstore32", 8) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "vstore64", 8) != 0 { return 1 }
    // GPU mega-kernel cross-WG barrier intrinsic.
    // mega_barrier(counter_ptr, phase_idx, wg_persist) -> void
    // Lowered by the AMDGPU emitter to the validated global_atomic_add_u32
    // + spin-loop ISA sequence.  Not a real function call; no IR_CALL emitted.
    if sema_tok_matches(tok_idx, "mega_barrier", 12) != 0 { return 1 }
    return 0
}

// Return expected argument count for a builtin, or 0xFFFFFFFF for variable-arg builtins
fn builtin_arg_count(uint64 tok_idx) -> uint64 {
    // 1-arg builtins
    if sema_tok_matches(tok_idx, "exit", 4) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "print", 5) != 0 { return 0xFFFFFFFF }
    if sema_tok_matches(tok_idx, "println", 7) != 0 { return 0xFFFFFFFF }
    if sema_tok_matches(tok_idx, "print_str", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "println_str", 11) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "load8", 5) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "load16", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "load32", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "load64", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "vload8", 6) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "vload16", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "vload32", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "vload64", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "alloc", 5) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "dealloc", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "str_len", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "file_close", 10) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "file_size", 9) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "fn_addr", 7) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "exec_process", 12) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "set_executable", 14) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "atomic_load", 11) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "dcache_flush", 12) != 0 { return 1 }
    if sema_tok_matches(tok_idx, "icache_invalidate", 17) != 0 { return 1 }
    // 2-arg builtins
    if sema_tok_matches(tok_idx, "exec_process_argv", 17) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "store8", 6) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "store16", 7) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "store32", 7) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "store64", 7) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "vstore8", 7) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "vstore16", 8) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "vstore32", 8) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "vstore64", 8) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "str_eq", 6) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "file_open", 9) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "bit_get", 7) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "bit_set", 7) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "bit_clear", 9) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "signed_lt", 9) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "signed_gt", 9) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "signed_le", 9) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "signed_ge", 9) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "get_module_path", 15) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "fmt_uint", 8) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "atomic_store", 12) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "atomic_add", 10) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "atomic_sub", 10) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "atomic_and", 10) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "atomic_or", 9) != 0 { return 2 }
    if sema_tok_matches(tok_idx, "atomic_xor", 10) != 0 { return 2 }
    // 3-arg builtins
    if sema_tok_matches(tok_idx, "write", 5) != 0 { return 3 }
    if sema_tok_matches(tok_idx, "memcpy", 6) != 0 { return 3 }
    if sema_tok_matches(tok_idx, "memset", 6) != 0 { return 3 }
    if sema_tok_matches(tok_idx, "file_read", 9) != 0 { return 3 }
    if sema_tok_matches(tok_idx, "file_write", 10) != 0 { return 3 }
    if sema_tok_matches(tok_idx, "bit_range", 9) != 0 { return 3 }
    if sema_tok_matches(tok_idx, "atomic_cas", 10) != 0 { return 3 }
    if sema_tok_matches(tok_idx, "mega_barrier", 12) != 0 { return 3 }
    // 4-arg builtins
    if sema_tok_matches(tok_idx, "bit_insert", 10) != 0 { return 4 }
    // 7-arg builtins
    if sema_tok_matches(tok_idx, "syscall_raw", 11) != 0 { return 7 }
    // 0-arg builtins
    if sema_tok_matches(tok_idx, "get_target_os", 13) != 0 { return 0 }
    if sema_tok_matches(tok_idx, "get_arch_id", 11) != 0 { return 0 }
    if sema_tok_matches(tok_idx, "time_ns", 7) != 0 { return 0 }
    if sema_tok_matches(tok_idx, "isb", 3) != 0 { return 0 }
    if sema_tok_matches(tok_idx, "dsb", 3) != 0 { return 0 }
    if sema_tok_matches(tok_idx, "dmb", 3) != 0 { return 0 }
    // Variable-arg builtins — skip checking
    if sema_tok_matches(tok_idx, "call_ptr", 8) != 0 { return 0xFFFFFFFF }
    if sema_tok_matches(tok_idx, "asm", 3) != 0 { return 0xFFFFFFFF }
    return 0xFFFFFFFF
}

// Recursively check expressions for call argument count mismatches
fn sema_check_expr(uint64 node) {
    if node == 0 { return }
    uint32 kind = ast_kind(node)

    if kind == 35 {
        // Call node: data1=callee_tok, child=first_arg
        uint32 callee_tok = ast_data1(node)
        uint64 wcallee = callee_tok
        if is_builtin(wcallee) != 0 {
            uint64 bexpected = builtin_arg_count(wcallee)
            if bexpected != 0xFFFFFFFF {
                // Count actual args
                uint64 bactual = 0
                uint32 barg = ast_child(node)
                uint64 wbarg = barg
                while wbarg != 0 {
                    bactual = bactual + 1
                    uint32 banxt = ast_next(wbarg)
                    wbarg = banxt
                }
                if bactual != bexpected {
                    report_error_at(wcallee, "wrong number of arguments to builtin")
                    sema_errors = sema_errors + 1
                }
            }
        } else {
            uint64 expected = fn_sig_lookup(wcallee)
            if expected != 0xFFFFFFFF {
                // Count actual args
                uint64 actual = 0
                uint32 arg = ast_child(node)
                uint64 warg = arg
                while warg != 0 {
                    actual = actual + 1
                    uint32 anxt = ast_next(warg)
                    warg = anxt
                }
                if actual != expected {
                    report_error_at(wcallee, "wrong number of arguments")
                    sema_errors = sema_errors + 1
                }
            }
        }
        // Recurse into call arguments
        uint32 arg2 = ast_child(node)
        uint64 warg2 = arg2
        while warg2 != 0 {
            sema_check_expr(warg2)
            uint32 anxt2 = ast_next(warg2)
            warg2 = anxt2
        }
        return
    }

    // BinOp: child=lhs, data2=rhs_idx
    if kind == 33 {
        uint32 lhs = ast_child(node)
        uint64 wlhs = lhs
        sema_check_expr(wlhs)
        uint32 rhs = ast_data2(node)
        uint64 wrhs = rhs
        sema_check_expr(wrhs)
        return
    }

    // Compare: child=lhs, data2=rhs_idx
    if kind == 38 {
        uint32 lhs = ast_child(node)
        uint64 wlhs = lhs
        sema_check_expr(wlhs)
        uint32 rhs = ast_data2(node)
        uint64 wrhs = rhs
        sema_check_expr(wrhs)
        return
    }

    // UnaryOp: child=operand
    if kind == 34 {
        uint32 operand = ast_child(node)
        uint64 wop = operand
        sema_check_expr(wop)
        return
    }

    // LogicalAnd: child=lhs, data2=rhs_idx (data1=op_tok)
    if kind == 39 {
        uint32 lhs = ast_child(node)
        uint64 wlhs = lhs
        sema_check_expr(wlhs)
        uint32 rhs = ast_data2(node)
        uint64 wrhs = rhs
        sema_check_expr(wrhs)
        return
    }

    // LogicalOr: child=lhs, data2=rhs_idx (data1=op_tok)
    if kind == 40 {
        uint32 lhs = ast_child(node)
        uint64 wlhs = lhs
        sema_check_expr(wlhs)
        uint32 rhs = ast_data2(node)
        uint64 wrhs = rhs
        sema_check_expr(wrhs)
        return
    }

    // Index: child=index_expr (data1=ident_tok)
    if kind == 37 {
        uint32 arr_ident_tok = ast_data1(node)
        uint64 warr_tok = arr_ident_tok
        uint64 arr_vi = sema_var_lookup_v(warr_tok)
        if arr_vi != 0xFFFFFFFF { sema_var_mark_used(arr_vi) }
        uint32 idx_expr = ast_child(node)
        uint64 widx = idx_expr
        sema_check_expr(widx)
        return
    }

    // FString (50): child = first segment (StrLit or expr), linked via next.
    // Without this, a variable used only inside an f-string gets a false
    // "unused variable" warning and calls inside segments skip arity checks.
    if kind == 50 {
        uint32 seg = ast_child(node)
        uint64 wseg = seg
        while wseg != 0 {
            sema_check_expr(wseg)
            uint32 snx = ast_next(wseg)
            wseg = snx
        }
        return
    }

    // Ident: a bare variable reference. Mark the variable used so the
    // unused-variable warning knows to skip it when its scope ends.
    // Also check whether the variable has been written yet — a read of
    // a never-initialized local is almost always a bug. The check is
    // conservative (linear source-order scan): a variable is "init"
    // if it had an initializer OR if any assignment to it was seen
    // earlier in the walk. Writes inside `if`/`match` branches count
    // unconditionally — so a read gated on the same condition that
    // writes the variable won't warn, but `if c { x = 5 } exit(x)`
    // where the read is outside the branch will also be silent. That
    // is deliberately looser than a full dataflow analysis — false
    // positives are worse than false negatives for this warning.
    if kind == 32 {
        uint32 id_tok = ast_data1(node)
        uint64 wid_tok = id_tok
        uint64 vi = sema_var_lookup_v(wid_tok)
        if vi != 0xFFFFFFFF {
            if sema_var_is_init(vi) == 0 {
                // Name starts with '_' opts out, same as unused-var.
                uint64 nstart = sema_tok_text_start(wid_tok)
                uint64 nch = 0
                uint64 np = sema_source + nstart
                unsafe { *(np as uint8) -> nch }
                if nch != 95 {
                    diag_emit(wid_tok, 1, 9)
                    // Mark init now so repeated reads don't pile up
                    // diagnostics for the same variable.
                    sema_var_mark_init(vi)
                }
            }
            sema_var_mark_used(vi)
        }
        return
    }

    // FieldAccess (36): both EnumName.Field (constant access) and
    // obj.field on a variable. In the variable case the object token is
    // the base var; mark it used. Walks the object chain so struct
    // method calls and nested access (p.inner.x) flow through.
    if kind == 36 {
        uint32 fa_obj = ast_child(node)
        uint64 wfa_obj = fa_obj
        if wfa_obj != 0 { sema_check_expr(wfa_obj) }
        uint32 fa_obj_tok = ast_data1(node)
        uint64 wfa_obj_tok = fa_obj_tok
        if wfa_obj_tok != 0 {
            uint64 fi = sema_var_lookup_v(wfa_obj_tok)
            if fi != 0xFFFFFFFF { sema_var_mark_used(fi) }
        }
        return
    }

    // RangePat (52): match-arm `lo .. hi` / `lo ..= hi`. Walk both
    // bounds so idents / calls inside them count as used.
    if kind == 52 {
        uint32 rp_lo = ast_data1(node)
        uint64 wrp_lo = rp_lo
        if wrp_lo != 0 { sema_check_expr(wrp_lo) }
        uint32 rp_hi = ast_data2(node)
        uint64 wrp_hi = rp_hi
        if wrp_hi != 0 { sema_check_expr(wrp_hi) }
        return
    }
}

// Check a statement for call argument count mismatches
fn sema_check_stmt(uint64 node) {
    if node == 0 { return }
    uint32 kind = ast_kind(node)

    // ExprStmt: child=expr
    if kind == 16 {
        uint32 expr = ast_child(node)
        uint64 wexpr = expr
        sema_check_expr(wexpr)
        return
    }

    // VarDecl: child=init_expr
    if kind == 10 {
        uint32 init = ast_child(node)
        uint64 winit = init
        // Decode the declared type here so both the init-expression
        // checks and the later sema_var_declare call can see it.
        uint32 vd_type_tok_idx = ast_data1(node)
        uint64 vd_type_tok = vd_type_tok_idx
        uint64 decl_type_kind = sema_tok_kind(vd_type_tok)
        // riscv32: reject a 64-bit / float declared type on the local.
        analysis_riscv32_reject_kind(decl_type_kind, vd_type_tok)
        if winit != 0 {
            sema_check_expr(winit)
            // Strict bool/int separation: check type tag of initializer
            uint32 type_tok_idx = ast_data1(node)
            uint64 wtype_tok = type_tok_idx
            // Get init expression type tag (data4 for IntLit bool-tagged nodes)
            uint32 init_kind_raw = ast_kind(winit)
            uint64 winit_kind = init_kind_raw
            uint64 init_type_tag = 0
            // IntLit = 30
            if winit_kind == 30 {
                uint32 itag = ast_data4(winit)
                init_type_tag = itag
            }
            // Check if init is a BinOp/Cast (as-cast): skip (data4 == 0 means no tag)
            if decl_type_kind == 98 && init_type_tag != 98 && init_type_tag != 0 {
                // decl is bool, init is some other typed literal
                report_error_at(wtype_tok, "type mismatch: expected bool")
                sema_errors = sema_errors + 1
            }
            if decl_type_kind != 98 && init_type_tag == 98 {
                // decl is non-bool, init is a bool literal
                report_error_at(wtype_tok, "type mismatch: bool requires explicit cast")
                sema_errors = sema_errors + 1
            }
            // Strict char/int separation (KwChar = 99)
            if decl_type_kind == 99 && init_type_tag != 99 && init_type_tag != 0 {
                // decl is char, init is some other typed literal (e.g. bool)
                report_error_at(wtype_tok, "type mismatch: expected char")
                sema_errors = sema_errors + 1
            }
            if decl_type_kind != 99 && init_type_tag == 99 {
                // decl is non-char, init is a char literal
                report_error_at(wtype_tok, "type mismatch: char requires explicit cast")
                sema_errors = sema_errors + 1
            }
            // Literal-overflow warning: if the initializer is an untagged
            // IntLit (not a bool/char literal) and the declared type is
            // narrower than u64, warn when the literal doesn't fit. This
            // catches the classic `u8 b = 300` foot-gun at compile time.
            if winit_kind == 30 && init_type_tag == 0 {
                uint32 lit_tok = ast_data1(winit)
                uint64 wlit_tok = lit_tok
                uint64 lit_val = parse_int_token(wlit_tok)
                uint64 limit = 0
                if decl_type_kind == 80 || decl_type_kind == 84 { limit = 0x100 }
                if decl_type_kind == 81 || decl_type_kind == 85 { limit = 0x10000 }
                if decl_type_kind == 82 || decl_type_kind == 86 { limit = 0x100000000 }
                if limit != 0 && lit_val >= limit {
                    report_warn_at(wtype_tok, "literal initializer does not fit the declared type (truncated)")
                }
                // riscv32/xtensa: a 32-bit target has no 64-bit integer
                // register, so an integer literal that doesn't fit in 32 bits
                // is a hard error (mirrors KernRift type_check.kr's 32-bit
                // literal-overflow diagnostic). Fires only under
                // --arch=riscv32 / --arch=xtensa.
                if (target_arch == 2 || target_arch == 3) && lit_val >= 0x100000000 {
                    if target_arch == 2 {
                        report_error_at(wtype_tok, "integer literal does not fit in 32 bits (64-bit integers not supported on riscv32)")
                    } else {
                        report_error_at(wtype_tok, "integer literal does not fit in 32 bits (64-bit integers not supported on xtensa)")
                    }
                    sema_errors = sema_errors + 1
                }
            }
        }
        // Register the new variable for unused-variable tracking. We
        // store the declared type's keyword kind (80 = u8, 81 = u16,
        // 82 = u32, …) so later Assign checks can re-derive the width
        // without a second AST lookup. If it has an initializer, also
        // mark it initialized. Params came in pre-declared in
        // sema_check_functions.
        uint32 vd_name_tok = ast_data2(node)
        uint64 wvd_name = vd_name_tok
        if wvd_name != 0 {
            sema_var_declare(wvd_name, decl_type_kind, 0)
            // Mark initialized if it has an initializer, OR if it is an
            // address-valued aggregate — an array (size in data3) or a struct
            // (marker in data4). The bare name of such a variable evaluates
            // to its stack address, so `fmt_uint(buf, n)` hands over a pointer
            // to write into; it is not an uninitialized READ. Without this,
            // every `uint8[N] buf` passed to a function warned spuriously.
            uint32 vd_arr = ast_data3(node)
            uint32 vd_struct = ast_data4(node)
            uint64 wvd_arr = vd_arr
            uint64 wvd_struct = vd_struct
            if sema_var_count_v > 0 {
                if winit != 0 || wvd_arr != 0 || wvd_struct != 0 {
                    sema_var_mark_init(sema_var_count_v - 1)
                }
            }
        }
        return
    }

    // Assign: child=value_expr, data1=target_name_tok
    if kind == 11 {
        uint32 val = ast_child(node)
        uint64 wval = val
        if wval != 0 { sema_check_expr(wval) }
        uint32 as_target = ast_data1(node)
        uint64 was_target = as_target
        if was_target != 0 {
            uint64 asv = sema_var_lookup_v(was_target)
            if asv != 0xFFFFFFFF {
                sema_var_mark_init(asv)
                // Literal-overflow warning for assignment, same shape as
                // in VarDecl. Only fires when the RHS is a bare IntLit
                // and the declared type is narrower than u64.
                if wval != 0 {
                    uint32 rhs_kind_raw = ast_kind(wval)
                    uint64 rhs_kind = rhs_kind_raw
                    if rhs_kind == 30 {
                        uint32 rhs_tag = ast_data4(wval)
                        uint64 rhs_type_tag = rhs_tag
                        if rhs_type_tag == 0 {
                            uint32 lit_tok_a = ast_data1(wval)
                            uint64 wlit_a = lit_tok_a
                            uint64 lit_val_a = parse_int_token(wlit_a)
                            uint64 tgt_kind = sema_var_type_id(asv)
                            uint64 limit_a = 0
                            if tgt_kind == 80 || tgt_kind == 84 { limit_a = 0x100 }
                            if tgt_kind == 81 || tgt_kind == 85 { limit_a = 0x10000 }
                            if tgt_kind == 82 || tgt_kind == 86 { limit_a = 0x100000000 }
                            if limit_a != 0 && lit_val_a >= limit_a {
                                report_warn_at(was_target, "literal assignment does not fit the target type (truncated)")
                            }
                        }
                    }
                }
            }
        }
        return
    }

    // Return: child=first_expr, data3=second_expr, data4=third_expr (for 2/3-tuple returns)
    if kind == 12 {
        uint32 expr = ast_child(node)
        uint64 wexpr = expr
        if wexpr != 0 { sema_check_expr(wexpr) }
        uint32 second = ast_data3(node)
        uint64 wsecond = second
        if wsecond != 0 { sema_check_expr(wsecond) }
        uint32 third = ast_data4(node)
        uint64 wthird = third
        if wthird != 0 { sema_check_expr(wthird) }
        return
    }

    // TupleDestruct: (T1 a, T2 b) = rhs_expr — walk the RHS only; the
    // two LHS slots are fresh declarations handled entirely in codegen.
    if kind == 44 {
        uint32 rhs = ast_child(node)
        uint64 wrhs = rhs
        if wrhs != 0 { sema_check_expr(wrhs) }
        return
    }

    // TupleDestruct3: (T1 a, T2 b, T3 c) = rhs_expr — same as 2-tuple
    if kind == 47 {
        uint32 rhs3 = ast_child(node)
        uint64 wrhs3 = rhs3
        if wrhs3 != 0 { sema_check_expr(wrhs3) }
        return
    }

    // If: child=condition, data1=then_block, data2=else_block
    if kind == 13 {
        uint32 cond = ast_child(node)
        uint64 wcond = cond
        sema_check_expr(wcond)
        uint32 then_blk = ast_data1(node)
        uint64 wthen = then_blk
        if wthen != 0 { sema_check_block(wthen) }
        uint32 else_blk = ast_data2(node)
        uint64 welse = else_blk
        if welse != 0 {
            uint32 ek = ast_kind(welse)
            if ek == 13 {
                sema_check_stmt(welse)
            } else {
                sema_check_block(welse)
            }
        }
        return
    }

    // While: child=condition, data1=body
    if kind == 14 {
        uint32 cond = ast_child(node)
        uint64 wcond = cond
        sema_check_expr(wcond)
        uint32 body = ast_data1(node)
        uint64 wbody = body
        if wbody != 0 { sema_check_block(wbody) }
        return
    }

    // Block: child=first_stmt
    if kind == 15 {
        sema_check_block(node)
        return
    }

    // PtrLoad (41): unsafe { *(addr as TYPE) -> dest_var }.
    // Walk the address expression and mark the destination as
    // initialized (the unsafe read gives it a value).
    if kind == 41 {
        uint32 pl_addr = ast_child(node)
        uint64 wpl_addr = pl_addr
        if wpl_addr != 0 { sema_check_expr(wpl_addr) }
        uint32 pl_dest = ast_data2(node)
        uint64 wpl_dest = pl_dest
        if wpl_dest != 0 {
            uint64 pli = sema_var_lookup_v(wpl_dest)
            if pli != 0xFFFFFFFF { sema_var_mark_init(pli) }
        }
        return
    }

    // PtrStore (42): unsafe { *(addr as TYPE) = val }.
    if kind == 42 {
        uint32 ps_addr = ast_child(node)
        uint64 wps_addr = ps_addr
        if wps_addr != 0 { sema_check_expr(wps_addr) }
        uint32 ps_val = ast_data2(node)
        uint64 wps_val = ps_val
        if wps_val != 0 { sema_check_expr(wps_val) }
        return
    }

    // Defer (51): walk the body in a nested scope so variables used
    // only inside the defer are counted as used.
    if kind == 51 {
        uint32 def_body = ast_data1(node)
        uint64 wdef_body = def_body
        if wdef_body != 0 { sema_check_block(wdef_body) }
        return
    }

    // Match: child=scrutinee, data1=first_arm
    if kind == 19 {
        uint32 scrut = ast_child(node)
        uint64 wscrut = scrut
        sema_check_expr(wscrut)
        // M14: reject a float scrutinee — float equality matching is
        // ill-defined; the backends compare bit patterns, so 0.1 + 0.2
        // would never match 0.3. Without a full type checker we catch
        // the two provable shapes: a float literal, or an Ident whose
        // declared type is float (sema_var_type_id stores the declared
        // type's token kind: 94 = f16, 95 = f32, 96 = f64).
        uint64 scrut_is_float = 0
        if wscrut != 0 {
            uint32 sck = ast_kind(wscrut)
            uint64 wsck = sck
            if wsck == 46 { scrut_is_float = 1 }   // FloatLitNode
            if wsck == 32 {
                uint32 sid_tok = ast_data1(wscrut)
                uint64 wsid_tok = sid_tok
                uint64 svi = sema_var_lookup_v(wsid_tok)
                if svi != 0xFFFFFFFF {
                    uint64 stid = sema_var_type_id(svi)
                    if stid == 94 || stid == 95 || stid == 96 {
                        scrut_is_float = 1
                    }
                }
            }
        }
        if scrut_is_float != 0 {
            // Both caught kinds (FloatLitNode, Ident) carry their token
            // in data1.
            uint32 mtok = ast_data1(wscrut)
            uint64 wmtok = mtok
            report_error_at(wmtok, "match on a float scrutinee is not supported (float equality is ill-defined); use if/else")
            sema_errors = sema_errors + 1
        }
        uint32 arm = ast_data1(node)
        uint64 warm = arm
        while warm != 0 {
            // Walk the arm's pattern chain (data1, linked via next) so
            // identifiers and calls inside patterns are visible to the
            // arity / unused-variable / use-before-init checks.
            uint32 pat = ast_data1(warm)
            uint64 wpat = pat
            while wpat != 0 {
                sema_check_expr(wpat)
                uint32 pnx = ast_next(wpat)
                wpat = pnx
            }
            uint32 arm_body = ast_data2(warm)
            uint64 wab = arm_body
            if wab != 0 { sema_check_block(wab) }
            uint32 anxt = ast_next(warm)
            warm = anxt
        }
        return
    }
}

// Check all statements in a block
fn sema_check_block(uint64 block_node) {
    if block_node == 0 { return }
    sema_scope_push()
    uint32 child = ast_child(block_node)
    uint64 wchild = child
    while wchild != 0 {
        sema_check_stmt(wchild)
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
    sema_scope_pop()
}

// Check all functions' bodies for call argument count mismatches
fn sema_check_functions(uint64 root) {
    sema_scope_init()
    uint32 child = ast_child(root)
    uint64 wchild = child
    while wchild != 0 {
        uint32 ck = ast_kind(wchild)
        if ck == 2 {
            // Outer per-function scope that holds the parameter bindings.
            // sema_check_block will push a second, nested scope for the
            // body itself — that matches C-family "parameters are in the
            // enclosing scope" semantics and keeps block locals distinct.
            sema_scope_push()
            // Declare params as "used already" so they never trigger the
            // unused-variable warning — callers dictate signatures.
            uint32 param = ast_child(wchild)
            uint64 wparam = param
            while wparam != 0 {
                uint32 pname_tok = ast_data2(wparam)
                uint64 wpname = pname_tok
                sema_var_declare(wpname, 0, 1)
                if sema_var_count_v > 0 {
                    sema_var_mark_used(sema_var_count_v - 1)
                }
                uint32 pnxt = ast_next(wparam)
                wparam = pnxt
            }
            uint32 body = ast_data3(wchild)
            uint64 wbody = body
            if wbody != 0 { sema_check_block(wbody) }
            sema_scope_pop()
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

// Does a single statement guarantee a return on all paths through it?
//   return-stmt              → yes
//   if/else where BOTH the then-block and the else-branch return → yes
//     (the else-branch may itself be an else-if, i.e. another if-node —
//      that is handled by recursing at the STATEMENT level, not the block
//      level; recursing via block_has_return on an if-node was the old bug,
//      since block_has_return walks ast_child expecting a block and would
//      read the if's condition expression instead of its branches.)
//   exit(...) call           → yes (never returns to the caller)
//   exhaustive match         → yes (see match_stmt_returns)
//   anything else            → no
// Mutually recursive with block_has_return; MLRift resolves cross-function
// references across the compilation unit, so definition order is irrelevant.
fn stmt_returns(uint64 stmt) -> uint64 {
    if stmt == 0 { return 0 }
    uint32 k = ast_kind(stmt)
    uint64 wk = k
    if wk == 12 { return 1 }
    if wk == 13 {
        uint32 then_blk = ast_data1(stmt)
        uint64 wthen = then_blk
        uint32 else_blk = ast_data2(stmt)
        uint64 welse = else_blk
        if welse == 0 { return 0 }
        if block_has_return(wthen) == 0 { return 0 }
        uint32 ek = ast_kind(welse)
        uint64 wek = ek
        if wek == 13 { return stmt_returns(welse) }   // else-if: recurse as statement
        return block_has_return(welse)                // plain else: block
    }
    // exit(...) never returns to the caller, so a function whose last
    // statement is an exit() call cannot fall off the end (M12).
    if wk == 16 {
        uint32 ec = ast_child(stmt)
        uint32 eck = ast_kind(ec)
        uint64 weck = eck
        if weck == 35 {
            uint32 callee = ast_data1(ec)
            uint64 wcallee = callee
            if sema_tok_matches(wcallee, "exit", 4) != 0 { return 1 }
        }
        return 0
    }
    // A match with a `_` default arm whose every arm returns on all paths
    // is exhaustive and terminating (M12). Without a default arm we can't
    // prove exhaustiveness over an integer scrutinee, so stay conservative.
    if wk == 19 { return match_stmt_returns(stmt) }
    return 0
}

// A structured block (no goto in MLRift) returns on all paths iff its last
// statement does.
fn block_has_return(uint64 block_node) -> uint64 {
    if block_node == 0 { return 0 }
    uint32 child = ast_child(block_node)
    uint64 wchild = child
    uint64 last = 0
    while wchild != 0 {
        last = wchild
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
    return stmt_returns(last)
}

// A `match` returns on all paths iff it has a `_` default arm AND every arm
// body returns on all paths. The default arm is an Ident pattern (kind 32)
// whose token is a single underscore, mirroring the backends' wildcard
// detection. (M12 — previously a function ending in an exhaustive match was
// wrongly flagged as falling off the end.)
fn match_stmt_returns(uint64 match_node) -> uint64 {
    uint32 arm = ast_data1(match_node)
    uint64 warm = arm
    if warm == 0 { return 0 }
    uint64 has_default = 0
    uint64 all_return = 1
    while warm != 0 {
        uint32 body = ast_data2(warm)
        uint64 wbody = body
        if block_has_return(wbody) == 0 { all_return = 0 }
        uint32 pat = ast_data1(warm)
        uint64 wpat = pat
        while wpat != 0 {
            uint32 pk = ast_kind(wpat)
            if pk == 32 {
                uint32 ptok = ast_data1(wpat)
                uint64 wptok = ptok
                if sema_tok_matches(wptok, "_", 1) != 0 { has_default = 1 }
            }
            uint32 pn = ast_next(wpat)
            wpat = pn
        }
        uint32 an = ast_next(warm)
        warm = an
    }
    if has_default != 0 && all_return != 0 { return 1 }
    return 0
}

// Check that all functions with return types actually return on all paths.
// Extern functions (no body) are declarations, not definitions — skip them.
fn sema_check_returns(uint64 root) {
    uint32 child = ast_child(root)
    uint64 wchild = child
    while wchild != 0 {
        uint32 ck = ast_kind(wchild)
        if ck == 2 {
            uint32 ret_tok = ast_data2(wchild)
            uint32 body = ast_data3(wchild)
            uint64 wbody = body
            if ret_tok != 0 && wbody != 0 {
                if block_has_return(wbody) == 0 {
                    uint32 name_tok = ast_data1(wchild)
                    uint64 wname = name_tok
                    report_error_at(wname, "function with return type may not return a value on all paths")
                    sema_errors = sema_errors + 1
                }
            }
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

// ---------------------------------------------------------------------------
// Unreachable code detection
// ---------------------------------------------------------------------------
// Walk each block's statement list. After a return/break/continue/exit(),
// any subsequent statement is unreachable. Emit warning (severity 1, msg 5)
// once per block, then stop scanning that block.

fn sema_ur_block(uint64 block_node) {
    uint64 terminated = 0
    uint32 child = ast_child(block_node)
    uint64 wchild = child
    while wchild != 0 {
        if terminated != 0 {
            // This statement is unreachable
            uint32 ur_tok = ast_tok(wchild)
            if ur_tok == 0 { ur_tok = ast_data1(wchild) }
            if ur_tok == 0 { ur_tok = ast_data2(wchild) }
            uint64 wur = ur_tok
            if wur != 0 {
                diag_emit(wur, 1, 5)
            }
            // Only warn once per block
            break
        }
        uint32 sk = ast_kind(wchild)
        uint64 wsk = sk
        // Check if this statement terminates the block
        if wsk == 12 { terminated = 1 }
        if wsk == 17 { terminated = 1 }
        if wsk == 18 { terminated = 1 }
        // Check for exit() call: ExprStmt(16) containing Call(35) to "exit"
        if wsk == 16 {
            uint32 expr_child = ast_child(wchild)
            uint32 expr_kind = ast_kind(expr_child)
            uint64 wek = expr_kind
            if wek == 35 {
                uint32 callee = ast_data1(expr_child)
                uint64 wcallee = callee
                if sema_tok_matches(wcallee, "exit", 4) != 0 {
                    terminated = 1
                }
            }
        }
        // Recurse into sub-blocks (if/else, while, nested blocks)
        if wsk == 13 {
            uint32 then_body = ast_data1(wchild)
            uint64 wthen = then_body
            if wthen != 0 { sema_ur_block(wthen) }
            uint32 else_body = ast_data2(wchild)
            uint64 welse = else_body
            if welse != 0 { sema_ur_block(welse) }
        }
        if wsk == 14 {
            uint32 while_body = ast_data1(wchild)
            uint64 wwbody = while_body
            if wwbody != 0 { sema_ur_block(wwbody) }
        }
        if wsk == 15 {
            sema_ur_block(wchild)
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

fn sema_check_unreachable(uint64 root) {
    uint32 child = ast_child(root)
    uint64 wchild = child
    while wchild != 0 {
        uint32 ck = ast_kind(wchild)
        if ck == 2 {
            uint32 body = ast_data3(wchild)
            uint64 wbody = body
            if wbody != 0 {
                sema_ur_block(wbody)
            }
        }
        uint32 nxt = ast_next(wchild)
        wchild = nxt
    }
}

// ===========================================================================
// Structural type checker (Track D — ported from KernRift src/type_check.kr)
// ===========================================================================
// 13 structural rules across 3 phases. Ported into analysis.mlr because
// MLRift keeps sema here (no separate type_check file by convention).
//
//   P1: A3 unknown-field, A4 field-of-non-struct, A6 return-type-mismatch,
//       B5 binop-on-struct, B7 bool-required-in-condition
//   P2: A5 void-fn-as-value, B1 assign-struct-vs-non, B2 assign-struct-kind,
//       B6 compare-on-struct
//   P3: B3 return-struct-mismatch, C7 return-float-kind (f32 vs f64),
//       C6 call-arg-struct-mismatch, C10 match-arm-type-mismatch
//
// Dialect deltas vs KernRift: MLRift has NO let / ternary (53) / match-EXPR
// (54), so those AST cases are dropped. riscv32/xtensa arch restrictions are
// Track A, not ported here. Reuses codegen.mlr's struct/fn_ret tables and
// token helpers (one global namespace — do NOT redefine).
//
// TypeKind tags: 0=unknown, 1=void, 80-87=int, 94-96=float, 98=bool, 99=char,
// 200+i=StructRef, 0xFFFFFFFF=poisoned.
//
// ROLLOUT: advisory-first. tc_diag emits a WARNING unless BOTH the master gate
// tc_fatal_enabled AND the per-rule fatal flag are set. Flip per-rule flags to
// fatal only after triaging false positives to zero on MLRift's own source.

static uint64 tc_local_table = 0
static uint64 tc_local_count = 0
static uint64 tc_local_cap = 0
static uint64 tc_current_ret_kind = 0
static uint64 tc_current_fn_tok = 0

static uint64 tc_fn_node_table = 0
static uint64 tc_fn_node_count = 0

static uint64 tc_fn_hash_tbl = 0
static uint64 tc_fn_hash_built_n = 0

static uint64 tc_local_hash_tbl = 0
static uint64 tc_local_gen = 0

// Diagnostic mode + error tally. Default fatal: false-positive triage against
// MLRift's own source AND the full test corpus came back clean (zero tc
// diagnostics), so all 13 rules ship fatal. `--no-check-types` downgrades to
// advisory (warnings only) at runtime via tc_set_fatal(0).
static uint64 tc_fatal_enabled = 1
static uint64 tc_error_count = 0

// FNV-1a over a token's source text — mirrors codegen.mlr dce_name_hash.
// (KernRift used tok_text_hash; MLRift has no such export, so provide one.)
fn tc_tok_hash(uint64 name_tok) -> uint64 {
    uint64 s = tok_text_start(name_tok)
    uint64 l = tok_text_len(name_tok)
    uint64 p = cg_source + s
    uint64 h = 2166136261
    uint64 i = 0
    while i < l {
        uint64 c = 0
        uint64 pc = p + i
        unsafe { *(pc as uint8) -> c }
        h = (h ^ c) * 16777619
        h = h & 0xFFFFFFFF
        i = i + 1
    }
    return h
}

// severity/mode router. rule_fatal = per-rule opt-in to fatal; the emission is
// only an error when tc_fatal_enabled AND rule_fatal are both nonzero.
fn tc_diag(uint64 tok, uint64 msg, uint64 rule_fatal) {
    if tc_fatal_enabled != 0 && rule_fatal != 0 {
        report_error_at(tok, msg)
        tc_error_count = tc_error_count + 1
    } else {
        report_warn_at(tok, msg)
    }
}

fn tc_fn_node_register(uint64 name_tok, uint64 fn_node) {
    if tc_fn_node_count >= 1024 { return }
    uint64 entry = tc_fn_node_table + tc_fn_node_count * 8
    uint32 nt = name_tok
    unsafe { *(entry as uint32) = nt }
    uint64 e4 = entry + 4
    uint32 fn32 = fn_node
    unsafe { *(e4 as uint32) = fn32 }
    tc_fn_node_count = tc_fn_node_count + 1
}

fn tc_fn_hash_sync() {
    if tc_fn_hash_tbl == 0 {
        tc_fn_hash_tbl = alloc(4096 * 8)
        uint64 ci = 0
        while ci < 4096 {
            uint64 sp = tc_fn_hash_tbl + ci * 8 + 4
            uint32 ff = 0xFFFFFFFF
            unsafe { *(sp as uint32) = ff }
            ci = ci + 1
        }
    }
    while tc_fn_hash_built_n < tc_fn_node_count {
        uint64 entry = tc_fn_node_table + tc_fn_hash_built_n * 8
        uint32 nt = 0
        unsafe { *(entry as uint32) -> nt }
        uint64 wnt = nt
        uint64 h = tc_tok_hash(wnt) & 4095
        uint64 placed = 0
        while placed == 0 {
            uint64 slot = tc_fn_hash_tbl + h * 8
            uint64 s4 = slot + 4
            uint32 sidx = 0
            unsafe { *(s4 as uint32) -> sidx }
            if sidx == 0xFFFFFFFF {
                uint32 nt2 = nt
                unsafe { *(slot as uint32) = nt2 }
                uint32 mi = tc_fn_hash_built_n
                unsafe { *(s4 as uint32) = mi }
                placed = 1
            } else {
                uint32 snt = 0
                unsafe { *(slot as uint32) -> snt }
                uint64 wsnt = snt
                if tok_text_eq(wsnt, wnt) != 0 { placed = 1 }
                else { h = (h + 1) & 4095 }
            }
        }
        tc_fn_hash_built_n = tc_fn_hash_built_n + 1
    }
}

fn tc_fn_node_lookup(uint64 name_tok) -> uint64 {
    tc_fn_hash_sync()
    uint64 h = tc_tok_hash(name_tok) & 4095
    while 1 == 1 {
        uint64 slot = tc_fn_hash_tbl + h * 8
        uint64 s4 = slot + 4
        uint32 sidx = 0
        unsafe { *(s4 as uint32) -> sidx }
        if sidx == 0xFFFFFFFF { return 0 }
        uint32 snt = 0
        unsafe { *(slot as uint32) -> snt }
        uint64 wsnt = snt
        if tok_text_eq(wsnt, name_tok) != 0 {
            uint64 wi = sidx
            uint64 entry = tc_fn_node_table + wi * 8
            uint64 e4 = entry + 4
            uint32 fn32 = 0
            unsafe { *(e4 as uint32) -> fn32 }
            return fn32
        }
        h = (h + 1) & 4095
    }
    return 0
}

fn tc_locals_reset() {
    tc_local_count = 0
    if tc_local_hash_tbl == 0 {
        tc_local_hash_tbl = alloc(16384 * 12)
        memset(tc_local_hash_tbl, 0, 16384 * 12)
    }
    tc_local_gen = tc_local_gen + 1
}

fn tc_init() {
    if tc_local_table == 0 {
        tc_local_cap = 4096
        tc_local_table = alloc(tc_local_cap * 8)
    }
    tc_locals_reset()
    if tc_fn_node_table == 0 {
        tc_fn_node_table = alloc(1024 * 8)
    }
    tc_fn_node_count = 0
}

fn tc_local_find_slot(uint64 name_tok) -> uint64 {
    uint64 h = tc_tok_hash(name_tok) & 16383
    uint32 cur_gen = tc_local_gen
    while 1 == 1 {
        uint64 slot = tc_local_hash_tbl + h * 12
        uint32 g = 0
        unsafe { *(slot as uint32) -> g }
        if g != cur_gen { return slot }
        uint64 s4 = slot + 4
        uint32 nt = 0
        unsafe { *(s4 as uint32) -> nt }
        uint64 wnt = nt
        if tok_text_eq(wnt, name_tok) != 0 { return slot }
        h = (h + 1) & 16383
    }
    return 0
}

fn tc_local_register(uint64 name_tok, uint64 typekind) {
    if tc_local_count >= tc_local_cap { return }
    uint64 entry = tc_local_table + tc_local_count * 8
    uint32 nt = name_tok
    unsafe { *(entry as uint32) = nt }
    uint64 e4 = entry + 4
    uint32 tk = typekind
    unsafe { *(e4 as uint32) = tk }
    tc_local_count = tc_local_count + 1
    uint64 slot = tc_local_find_slot(name_tok)
    uint32 cur_gen = tc_local_gen
    unsafe { *(slot as uint32) = cur_gen }
    uint64 s4 = slot + 4
    unsafe { *(s4 as uint32) = nt }
    uint64 s8 = slot + 8
    unsafe { *(s8 as uint32) = tk }
}

fn tc_local_lookup(uint64 name_tok) -> uint64 {
    uint64 slot = tc_local_find_slot(name_tok)
    uint32 g = 0
    unsafe { *(slot as uint32) -> g }
    uint32 cur_gen = tc_local_gen
    if g != cur_gen { return 0 }
    uint64 s8 = slot + 8
    uint32 tk = 0
    unsafe { *(s8 as uint32) -> tk }
    return tk
}

// Map a type-keyword / struct-name token to a TypeKind. (riscv32/xtensa
// rejection from KernRift is Track A — dropped here.)
fn tc_kind_of_type_tok(uint64 type_tok) -> uint64 {
    if type_tok == 0 { return 1 }   // void
    uint64 k = tok_kind_at_raw(type_tok)
    if k >= 80 && k <= 87 { return k }
    if k >= 94 && k <= 96 { return k }
    if k == 98 || k == 99 { return k }
    if k == 1 {
        uint64 si = struct_lookup(type_tok)
        if si != 0xFFFFFFFF { return 200 + si }
    }
    return 0
}

fn tc_is_struct_kind(uint64 tk) -> uint64 {
    if tk >= 200 && tk < 0xFFFF { return 1 }
    return 0
}

fn tc_is_float_kind(uint64 tk) -> uint64 {
    if tk >= 94 && tk <= 96 { return 1 }
    return 0
}

// Module-level static/const kind. MLRift's static table only tracks float-ness
// (static_fkind_of: 1=f64, 2=f32), so we resolve float globals precisely and
// return 0 (unknown) otherwise — a safe under-approximation that suppresses
// rather than false-positives on non-float globals.
fn tc_static_kind_of(uint64 name_tok) -> uint64 {
    uint64 fk = static_fkind_of(name_tok)
    if fk == 1 { return 96 }
    if fk == 2 { return 95 }
    return 0
}

// 1 iff `node` is a Call to a known, locally-defined void function.
// Unknown / extern / builtin callees return 0 (never flagged). Self-contained
// via tc_fn_node_lookup (KernRift used fn_sig_returns; equivalent here).
fn tc_call_returns_void(uint64 node) -> uint64 {
    if node == 0 { return 0 }
    uint32 kind = ast_kind(node)
    if kind != 35 { return 0 }
    uint32 callee = ast_data1(node)
    uint64 wcallee = callee
    uint64 fn_node = tc_fn_node_lookup(wcallee)
    if fn_node == 0 { return 0 }
    uint32 ret_tok = ast_data2(fn_node)
    if ret_tok == 0 { return 1 }
    return 0
}

// A float literal carrying the `f` suffix (`1.5f`, `2e5f`) is an f32 VALUE,
// not an f64: the FloatLit arm of ir_lower_expr narrows it with an explicit
// IR_F64TOF32 and tags the result vreg fkind=2. tc_expr_kind used to report
// f64 (96) for every FloatLit, so the return-kind check saw f32-declared vs
// f64-actual and rejected `fn f() -> f32 { return 1.5f }` — while the exact
// same literal bound to an `f32` local first passed, because the local's
// declared kind was consulted instead. That is why every other f32-returning
// function in std/gguf.mlr routes through a local; the one that did not made
// every program importing that file fail to build (sema checks every function
// in an imported file, called or not). This scan mirrors the IR's: any 'f'
// byte in the token text means f32 (the dialect has no hex floats, so 'f' can
// only be the suffix).
fn tc_float_lit_kind(uint64 node) -> uint64 {
    uint32 lit_tok = ast_data1(node)
    uint64 wlt = lit_tok
    uint64 tlen = tok_text_len(wlt)
    uint64 fi = 0
    while fi < tlen {
        uint64 ch = tok_source_byte(wlt, fi)
        if ch == 102 { return 95 }          // 'f' suffix -> f32
        fi = fi + 1
    }
    return 96                                // plain literal -> f64
}

// Derive the TypeKind of an expression. 0 = unknown, 0xFFFFFFFF = poisoned.
fn tc_expr_kind(uint64 node) -> uint64 {
    if node == 0 { return 0 }
    uint32 kind = ast_kind(node)
    uint64 wkind = kind
    if wkind == 30 {
        uint32 d4 = ast_data4(node)
        uint64 wd4 = d4
        if wd4 == 98 { return 98 }
        if wd4 == 99 { return 99 }
        return 83
    }
    if wkind == 46 { return tc_float_lit_kind(node) }
    if wkind == 31 { return 83 }
    if wkind == 32 {
        uint32 nt = ast_data1(node)
        uint64 wnt = nt
        uint64 lk = tc_local_lookup(wnt)
        if lk != 0 { return lk }
        return tc_static_kind_of(wnt)
    }
    if wkind == 38 { return 98 }
    if wkind == 39 { return 98 }
    if wkind == 40 { return 98 }
    if wkind == 33 {
        uint32 lhs = ast_child(node)
        uint64 wlhs = lhs
        return tc_expr_kind(wlhs)
    }
    if wkind == 34 {
        uint32 op = ast_child(node)
        uint64 wop = op
        return tc_expr_kind(wop)
    }
    // (kinds 53 ternary / 54 match-expr do not exist in MLRift — dropped)
    if wkind == 35 {
        uint32 callee = ast_data1(node)
        uint64 wcallee = callee
        uint64 fret = fn_ret_float_lookup(wcallee)
        if fret == 1 { return 96 }
        if fret == 2 { return 95 }
        uint64 sret = fn_ret_struct_lookup(wcallee)
        if sret != 0xFFFFFFFF { return 200 + sret }
        uint64 fn_node = tc_fn_node_lookup(wcallee)
        if fn_node != 0 {
            uint32 ret_tok = ast_data2(fn_node)
            uint64 wret = ret_tok
            if wret != 0 {
                uint64 rk = tc_kind_of_type_tok(ret_tok)
                if rk >= 80 && rk <= 99 { return rk }
                if rk >= 200 && rk != 0xFFFFFFFF { return rk }
            }
        }
        return 83
    }
    if wkind == 36 {
        uint32 recv = ast_child(node)
        uint64 wrecv = recv
        uint64 rk = tc_expr_kind(wrecv)
        if tc_is_struct_kind(rk) == 0 { return 0xFFFFFFFF }
        uint64 si = rk - 200
        uint32 ft = ast_data2(node)
        uint64 wft = ft
        uint64 ftk = struct_field_type_kind_by_tok(si, wft)
        if ftk == 0 { return 0xFFFFFFFF }
        if ftk >= 256 { return 200 + (ftk - 256) }
        return ftk
    }
    if wkind == 49 { return 83 }
    if wkind == 37 { return 83 }
    if wkind == 48 {
        uint32 type_tok = ast_data1(node)
        uint64 wtt = type_tok
        return tc_kind_of_type_tok(wtt)
    }
    return 0
}

fn tc_check_expr(uint64 node) {
    if node == 0 { return }
    uint32 kind = ast_kind(node)
    uint64 wkind = kind

    // Call (35): walk args, then C6 param/arg struct-kind check.
    if wkind == 35 {
        uint32 arg = ast_child(node)
        uint64 warg = arg
        while warg != 0 {
            tc_check_expr(warg)
            uint32 anxt = ast_next(warg)
            warg = anxt
        }
        uint32 callee = ast_data1(node)
        uint64 wcallee = callee
        uint64 fn_node = tc_fn_node_lookup(wcallee)
        if fn_node != 0 {
            uint32 param = ast_child(fn_node)
            uint64 wp = param
            uint32 ai = ast_child(node)
            uint64 wai = ai
            while wp != 0 && wai != 0 {
                uint32 pk = ast_kind(wp)
                if pk != 3 { wp = 0 }
                if pk == 3 {
                    uint32 ptype_tok = ast_data1(wp)
                    uint64 wptype = ptype_tok
                    uint64 expected = tc_kind_of_type_tok(wptype)
                    uint64 actual = tc_expr_kind(wai)
                    if expected != 0 && actual != 0 && actual != 0xFFFFFFFF {
                        uint64 e_struct = tc_is_struct_kind(expected)
                        uint64 a_struct = tc_is_struct_kind(actual)
                        // ---- C6 ----
                        if e_struct != 0 && a_struct != 0 && expected != actual {
                            uint32 atok = ast_tok(wai)
                            uint64 watok = atok
                            tc_diag(watok, "argument struct kind does not match parameter type", 1)
                        }
                        // ---- C6f: call-arg float-kind mismatch ----
                        // Same silent-miscompile class C7 catches on the return
                        // path, which had no equivalent here: passing an f64
                        // value (or an unsuffixed literal, which is f64) to an
                        // f32 parameter put f64 bits in the register and the
                        // callee read 0.0. Non-inlined only — a one-expression
                        // callee gets inlined and hides it, which is why this
                        // survived. Write 1.5f, or convert explicitly.
                        if tc_is_float_kind(expected) != 0 && tc_is_float_kind(actual) != 0 {
                            if expected != actual {
                                uint32 fatok = ast_tok(wai)
                                uint64 wfatok = fatok
                                tc_diag(wfatok, "argument float kind does not match parameter type", 1)
                            }
                        }
                    }
                    uint32 pn = ast_next(wp)
                    wp = pn
                    uint32 anxt2 = ast_next(wai)
                    wai = anxt2
                }
            }
        }
        return
    }

    // BinOp (33), Compare (38): child=lhs, data2=rhs.
    if wkind == 33 || wkind == 38 {
        uint32 lhs = ast_child(node)
        uint64 wlhs = lhs
        if wlhs != 0 { tc_check_expr(wlhs) }
        uint32 rhs = ast_data2(node)
        uint64 wrhs = rhs
        if wrhs != 0 { tc_check_expr(wrhs) }
        uint64 lk = tc_expr_kind(wlhs)
        uint64 rk = tc_expr_kind(wrhs)
        // ---- B5: binop-on-struct ----
        if wkind == 33 {
            if tc_is_struct_kind(lk) != 0 || tc_is_struct_kind(rk) != 0 {
                uint32 ot = ast_tok(node)
                uint64 wot = ot
                tc_diag(wot, "arithmetic operator on struct value", 1)
            }
        }
        // ---- B6: ordering-comparison-on-struct (== / != are allowed) ----
        if wkind == 38 {
            uint32 op_tok = ast_data1(node)
            uint64 wop_tok = op_tok
            uint64 opk = tok_kind_at_raw(wop_tok)
            if opk != 35 && opk != 36 {
                if tc_is_struct_kind(lk) != 0 || tc_is_struct_kind(rk) != 0 {
                    uint32 ot = ast_tok(node)
                    uint64 wot = ot
                    tc_diag(wot, "ordering comparison on struct value (compare fields individually)", 1)
                }
            }
        }
        // ---- A5: void-fn-used-as-value ----
        if tc_call_returns_void(wlhs) != 0 || tc_call_returns_void(wrhs) != 0 {
            uint32 ot = ast_tok(node)
            uint64 wot = ot
            tc_diag(wot, "result of void-returning function used as a value", 1)
        }
        return
    }

    // LogicalAnd (39), LogicalOr (40): child=lhs, data2=rhs.
    if wkind == 39 || wkind == 40 {
        uint32 lhs = ast_child(node)
        uint64 wlhs = lhs
        if wlhs != 0 { tc_check_expr(wlhs) }
        uint32 rhs = ast_data2(node)
        uint64 wrhs = rhs
        if wrhs != 0 { tc_check_expr(wrhs) }
        return
    }

    // UnaryOp (34): child=operand.
    if wkind == 34 {
        uint32 op = ast_child(node)
        uint64 wop = op
        if wop != 0 { tc_check_expr(wop) }
        return
    }

    // FieldAccess (36): child=recv, data2=field-name token.
    if wkind == 36 {
        uint32 recv = ast_child(node)
        uint64 wrecv = recv
        if wrecv != 0 { tc_check_expr(wrecv) }
        uint32 fname0 = ast_data2(node)
        uint64 wfname0 = fname0
        if tok_matches(wfname0, "len", 3) != 0 { return }
        uint64 rk = tc_expr_kind(wrecv)
        uint64 recv_is_index = 0
        if wrecv != 0 {
            uint32 recv_k = ast_kind(wrecv)
            if recv_k == 37 { recv_is_index = 1 }
        }
        // ---- A4: struct-field-of-non-struct ----
        if rk != 0 && rk != 0xFFFFFFFF && tc_is_struct_kind(rk) == 0 && recv_is_index == 0 {
            uint32 ft = ast_tok(node)
            uint64 wft = ft
            tc_diag(wft, "field access on non-struct value", 1)
        }
        // ---- A3: unknown-field ----
        if tc_is_struct_kind(rk) != 0 {
            uint64 si = rk - 200
            uint32 fname = ast_data2(node)
            uint64 wfn = fname
            uint64 fo = struct_field_offset(si, wfn)
            if fo == 0xFFFFFFFF {
                tc_diag(wfn, "no such field on this struct type", 1)
            }
        }
        return
    }

    // Index (37): child=index_expr.
    if wkind == 37 {
        uint32 idx = ast_child(node)
        uint64 widx = idx
        if widx != 0 { tc_check_expr(widx) }
        return
    }

    // FString (50): child=first segment, linked via next.
    if wkind == 50 {
        uint32 seg = ast_child(node)
        uint64 wseg = seg
        while wseg != 0 {
            tc_check_expr(wseg)
            uint32 snxt = ast_next(wseg)
            wseg = snxt
        }
        return
    }
}

fn tc_check_stmt(uint64 node) {
    if node == 0 { return }
    uint32 kind = ast_kind(node)
    uint64 wkind = kind

    // Block (15).
    if wkind == 15 {
        uint32 c = ast_child(node)
        uint64 wc = c
        while wc != 0 {
            tc_check_stmt(wc)
            uint32 nxt = ast_next(wc)
            wc = nxt
        }
        return
    }

    // VarDecl (10): register var with its type, then check init (B1/B2, A5).
    if wkind == 10 {
        uint32 type_tok = ast_data1(node)
        uint32 name_tok = ast_data2(node)
        uint32 d4 = ast_data4(node)
        uint64 wtt_tc = type_tok
        uint64 wd4_tc = d4
        uint64 tk = 0
        if wd4_tc != 0 {
            tk = 200 + (wd4_tc - 1)
        } else {
            tk = tc_kind_of_type_tok(type_tok)
        }
        tc_local_register(name_tok, tk)
        uint32 init = ast_child(node)
        uint64 winit = init
        if winit != 0 {
            tc_check_expr(winit)
            // ---- A5 ----
            if tc_call_returns_void(winit) != 0 {
                uint32 it = ast_tok(node)
                uint64 wit = it
                tc_diag(wit, "void-returning function used to initialize a variable", 1)
            }
            // ---- B1 / B2 ----
            uint64 ik = tc_expr_kind(winit)
            if ik != 0 && ik != 0xFFFFFFFF {
                uint64 lhs_struct = tc_is_struct_kind(tk)
                uint64 rhs_struct = tc_is_struct_kind(ik)
                if lhs_struct != 0 && rhs_struct != 0 && tk != ik {
                    uint32 it = ast_tok(node)
                    uint64 wit = it
                    tc_diag(wit, "initializer struct kind does not match declared type", 1)
                }
            }
        }
        return
    }

    // Assign (11): data1=name_tok, child=value_expr.
    // PtrStore(42): the destination float kind now drives a narrow/widen in
    // the IR, so a mismatch is converted rather than rejected — the same rule
    // a local assignment follows. Still recurse for the sub-expressions.
    if wkind == 42 {
        uint32 ps_addr = ast_child(node)
        uint64 wpsa = ps_addr
        if wpsa != 0 { tc_check_expr(wpsa) }
        uint32 ps_val = ast_data2(node)
        uint64 wpsv = ps_val
        if wpsv != 0 { tc_check_expr(wpsv) }
        return
    }

    // ---- C8: field-assign kind mismatch ----
    if wkind == 36 {
        uint32 fa_v = ast_data3(node)
        uint64 wfav = fa_v
        uint32 fa_is_store = ast_data4(node)
        if fa_is_store == 1 && wfav != 0 {
            tc_check_expr(wfav)
            uint32 fa_obj = ast_child(node)
            uint64 wfo = fa_obj
            uint64 ok2 = tc_expr_kind(wfo)
            if ok2 >= 200 && ok2 != 0xFFFFFFFF {
                uint64 si2 = ok2 - 200
                uint32 ftok2 = ast_data2(node)
                uint64 wft2 = ftok2
                uint64 fk2 = struct_field_type_kind_by_tok(si2, wft2)
                uint64 vk2 = tc_expr_kind(wfav)
                if fk2 != 0 && vk2 != 0 && vk2 != 0xFFFFFFFF {
                    // Float kind needs no rule: the IR now narrows/widens the
                    // value to the field's declared kind. Struct kind still
                    // clashes — nothing to convert between two struct types.
                    if tc_is_struct_kind(fk2) != 0 && tc_is_struct_kind(vk2) != 0 {
                        if fk2 != vk2 {
                            uint32 fdt2 = ast_tok(node)
                            uint64 wfdt2 = fdt2
                            tc_diag(wfdt2, "field assignment struct kind does not match field type", 1)
                        }
                    }
                }
            }
        }
        return
    }

    if wkind == 11 {
        uint32 c = ast_child(node)
        uint64 wc = c
        if wc != 0 { tc_check_expr(wc) }
        // ---- A5 ----
        if tc_call_returns_void(wc) != 0 {
            uint32 atok = ast_tok(node)
            uint64 watok = atok
            tc_diag(watok, "void-returning function assigned to a variable", 1)
        }
        // ---- B1 / B2 ----
        uint32 lhs_name = ast_data1(node)
        uint64 wln = lhs_name
        uint64 lk = tc_local_lookup(wln)
        // A module-level static is not in the local table, so this check used
        // to skip it entirely: `g_a = b` with mismatched structs and
        // `g_f32 = f64fn()` were both accepted in silence.
        uint64 lhs_is_static = 0
        if lk == 0 {
            uint64 ssi2 = static_struct_lookup(wln)
            if ssi2 != 0xFFFFFFFF {
                lk = 200 + ssi2
                lhs_is_static = 1
            } else {
                lk = tc_static_kind_of(wln)
                if lk != 0 { lhs_is_static = 1 }
            }
        }
        uint64 rk = tc_expr_kind(wc)
        if lk != 0 && rk != 0 && rk != 0xFFFFFFFF {
            uint64 lhs_struct = tc_is_struct_kind(lk)
            uint64 rhs_struct = tc_is_struct_kind(rk)
            if lhs_struct != 0 && rhs_struct != 0 && lk != rk {
                uint32 atok = ast_tok(node)
                uint64 watok = atok
                tc_diag(watok, "assignment struct kind does not match", 1)
            }
            // Float kind needs no rule here either: both the local and the
            // static store paths now narrow/widen the value to the slot.
        }
        return
    }

    // Return (12): A6 + A5 + B3 + C7.
    if wkind == 12 {
        uint32 expr = ast_child(node)
        uint64 wexpr = expr
        if tc_current_ret_kind == 1 {
            // ---- A6: void fn — return must be bare ----
            if wexpr != 0 {
                uint32 rt = ast_tok(node)
                uint64 wrt = rt
                tc_diag(wrt, "return with value in void function", 1)
                tc_check_expr(wexpr)
            }
        } else {
            // ---- A6: non-void fn — return must carry a value ----
            if wexpr == 0 {
                uint32 rt = ast_tok(node)
                uint64 wrt = rt
                tc_diag(wrt, "return without value in non-void function", 1)
            } else {
                tc_check_expr(wexpr)
                // ---- A5 ----
                if tc_call_returns_void(wexpr) != 0 {
                    uint32 rt = ast_tok(node)
                    uint64 wrt = rt
                    tc_diag(wrt, "returning the result of a void-returning function", 1)
                }
                uint64 rk = tc_expr_kind(wexpr)
                if rk != 0 && rk != 0xFFFFFFFF {
                    uint64 lhs_struct = tc_is_struct_kind(tc_current_ret_kind)
                    uint64 rhs_struct = tc_is_struct_kind(rk)
                    // ---- B3 ----
                    if lhs_struct != 0 && rhs_struct != 0 && tc_current_ret_kind != rk {
                        uint32 rt = ast_tok(node)
                        uint64 wrt = rt
                        tc_diag(wrt, "return value struct kind does not match declared type", 1)
                    }
                    // ---- C7 ----
                    if tc_is_float_kind(tc_current_ret_kind) != 0 && tc_is_float_kind(rk) != 0 {
                        if tc_current_ret_kind != rk {
                            uint32 rt = ast_tok(node)
                            uint64 wrt = rt
                            tc_diag(wrt, "return value float kind does not match declared type", 1)
                        }
                    }
                }
            }
        }
        return
    }

    // ExprStmt (16).
    if wkind == 16 {
        uint32 e = ast_child(node)
        uint64 we = e
        tc_check_expr(we)
        return
    }

    // If (13): child=cond, data1=then, data2=else. ---- B7 ----
    if wkind == 13 {
        uint32 cond = ast_child(node)
        uint64 wcond = cond
        if wcond != 0 {
            uint64 ck = tc_expr_kind(wcond)
            if tc_is_struct_kind(ck) != 0 {
                uint32 tt = ast_tok(node)
                uint64 wtt = tt
                tc_diag(wtt, "condition must be a scalar, got struct value", 1)
            }
            if tc_is_float_kind(ck) != 0 {
                uint32 tt = ast_tok(node)
                uint64 wtt = tt
                tc_diag(wtt, "condition must be a scalar, got float value", 1)
            }
            tc_check_expr(wcond)
        }
        uint32 thenb = ast_data1(node)
        uint64 wt = thenb
        if wt != 0 { tc_check_stmt(wt) }
        uint32 elseb = ast_data2(node)
        uint64 we2 = elseb
        if we2 != 0 { tc_check_stmt(we2) }
        return
    }

    // Match (19): child=scrutinee, data1=first_arm. ---- C10 ----
    if wkind == 19 {
        uint32 scrut = ast_child(node)
        uint64 wscrut = scrut
        if wscrut != 0 { tc_check_expr(wscrut) }
        uint64 sk = tc_expr_kind(wscrut)
        // (float-scrutinee reject omitted: MLRift sema already fatally rejects
        //  it in sema_check_stmt / M14.)
        uint32 arm = ast_data1(node)
        uint64 warm = arm
        while warm != 0 {
            uint32 ak = ast_kind(warm)
            if ak == 20 {
                uint32 pat = ast_data1(warm)
                uint64 wpat = pat
                while wpat != 0 {
                    uint32 pk = ast_kind(wpat)
                    uint64 skip = 0
                    if pk == 32 {
                        uint32 nt = ast_data1(wpat)
                        uint64 wnt = nt
                        if tc_local_lookup(wnt) == 0 { skip = 1 }
                    }
                    if pk == 52 { skip = 1 }
                    if skip == 0 {
                        uint64 pkk = tc_expr_kind(wpat)
                        if pkk != 0 && pkk != 0xFFFFFFFF && sk != 0 && sk != 0xFFFFFFFF {
                            uint64 s_struct = tc_is_struct_kind(sk)
                            uint64 p_struct = tc_is_struct_kind(pkk)
                            if s_struct != 0 && p_struct != 0 && sk != pkk {
                                uint32 pt = ast_tok(wpat)
                                uint64 wpt = pt
                                tc_diag(wpt, "match-arm pattern struct kind does not match scrutinee", 1)
                            }
                        }
                        tc_check_expr(wpat)
                    }
                    uint32 pn = ast_next(wpat)
                    wpat = pn
                }
                uint32 body = ast_data2(warm)
                uint64 wbody = body
                if wbody != 0 { tc_check_stmt(wbody) }
            }
            uint32 anxt = ast_next(warm)
            warm = anxt
        }
        return
    }

    // While (14): child=cond, data1=body. ---- B7 ----
    if wkind == 14 {
        uint32 cond = ast_child(node)
        uint64 wcond = cond
        if wcond != 0 {
            uint64 ck = tc_expr_kind(wcond)
            if tc_is_struct_kind(ck) != 0 {
                uint32 tt = ast_tok(node)
                uint64 wtt = tt
                tc_diag(wtt, "condition must be a scalar, got struct value", 1)
            }
            if tc_is_float_kind(ck) != 0 {
                uint32 tt = ast_tok(node)
                uint64 wtt = tt
                tc_diag(wtt, "condition must be a scalar, got float value", 1)
            }
            tc_check_expr(wcond)
        }
        uint32 body = ast_data1(node)
        uint64 wb = body
        if wb != 0 { tc_check_stmt(wb) }
        return
    }

    // Default: walk children as statements.
    uint32 c2 = ast_child(node)
    uint64 wc2 = c2
    while wc2 != 0 {
        tc_check_stmt(wc2)
        uint32 nxt = ast_next(wc2)
        wc2 = nxt
    }
}

fn tc_check_function(uint64 fn_node) {
    tc_locals_reset()
    uint32 fn_tok = ast_data1(fn_node)
    uint32 ret_tok = ast_data2(fn_node)
    tc_current_fn_tok = fn_tok
    tc_current_ret_kind = tc_kind_of_type_tok(ret_tok)
    if ret_tok == 0 { tc_current_ret_kind = 1 }

    uint32 param = ast_child(fn_node)
    uint64 wp = param
    while wp != 0 {
        uint32 pkind = ast_kind(wp)
        if pkind == 3 {
            uint32 ptype_tok = ast_data1(wp)
            uint32 pname_tok = ast_data2(wp)
            uint64 wptype = ptype_tok
            uint64 ptk = tc_kind_of_type_tok(wptype)
            tc_local_register(pname_tok, ptk)
        }
        uint32 nxt = ast_next(wp)
        wp = nxt
    }

    uint32 b = ast_data3(fn_node)
    uint64 body = b
    if body != 0 { tc_check_stmt(body) }
}

// Pre-pass: seed fn_ret_struct/float tables (so tc_expr_kind can resolve Call
// return kinds) and the name->fn_node table (for C6). Method-table seeding and
// riscv return-type rejection from KernRift are not applicable here.
fn tc_collect_signatures(uint64 root) {
    uint32 child = ast_child(root)
    uint64 wc = child
    while wc != 0 {
        uint32 ck = ast_kind(wc)
        if ck == 2 {
            uint32 fname = ast_data1(wc)
            uint32 ret_tok = ast_data2(wc)
            uint64 wname = fname
            uint64 wret = ret_tok
            tc_fn_node_register(wname, wc)
            if wret != 0 {
                uint64 rk = tok_kind_at_raw(wret)
                if rk == 96 { fn_ret_float_register(wname, 1) }
                if rk == 95 { fn_ret_float_register(wname, 2) }
                if rk == 1 {
                    uint64 si = struct_lookup(wret)
                    if si != 0xFFFFFFFF {
                        fn_ret_struct_register(wname, si)
                    }
                }
            }
        }
        uint32 nxt = ast_next(wc)
        wc = nxt
    }
}

// Optional master switch for fatal mode (advisory-first default = 0).
@export
fn tc_set_fatal(uint64 v) {
    tc_fatal_enabled = v
}

@export
fn tc_check_module(uint64 root) -> uint64 {
    tc_init()
    tc_error_count = 0
    // Snapshot codegen-side return-type table counts (statics in codegen.mlr,
    // reachable in this shared namespace) and roll them back after the pre-pass
    // so codegen's own walk starts from a clean count.
    uint64 saved_struct_count = fn_ret_struct_count
    uint64 saved_float_count = fn_ret_float_count
    tc_collect_signatures(root)

    uint32 child = ast_child(root)
    uint64 wc = child
    while wc != 0 {
        uint32 ck = ast_kind(wc)
        if ck == 2 {
            tc_check_function(wc)
        }
        uint32 nxt = ast_next(wc)
        wc = nxt
    }

    fn_ret_struct_count = saved_struct_count
    fn_ret_float_count = saved_float_count
    return tc_error_count
}

// Entry point for semantic validation
@export
fn run_semantic_checks(uint64 root, uint64 source, uint64 tok_buf) -> uint64 {
    sema_init(source, tok_buf)
    diag_init()
    sema_collect_signatures(root)
    sema_check_functions(root)
    sema_check_returns(root)
    sema_check_unreachable(root)
    return sema_errors + diag_error_count
}
