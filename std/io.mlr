// KernRift Standard Library — I/O Operations

// Read entire file into a string (allocates buffer, returns pointer)
// Returns 0 only if `path` could not be opened. A path that opens
// successfully but is zero-length returns a valid pointer to an
// allocated empty (zero-length, null-terminated) string — NOT 0 — so
// callers can tell "no such file" apart from "file exists and is
// empty" (the two used to share the 0 sentinel).
fn read_file(u64 path) -> u64 {
    u64 fd = file_open(path, 0)
    // file_open returns a negative errno (a huge unsigned value) on failure
    // — e.g. a missing path. Using that as an fd segfaults downstream, so
    // bail out with 0 as the doc promises.
    if is_errno(fd) != 0 { return 0 }
    u64 size = file_size(fd)
    u64 buf = alloc(size + 1)
    file_read(fd, buf, size)
    file_close(fd)
    // Null-terminate
    u64 tp = buf + size
    u8 z = 0
    store8(tp, z)
    return buf
}

// Write string to file (creates/overwrites)
fn write_file(u64 path, u64 content) {
    u64 len = str_len(content)
    u64 fd = file_open(path, 1)
    file_write(fd, content, len)
    file_close(fd)
}

// Append string to file
fn append_file(u64 path, u64 content) {
    // Read existing content
    u64 existing = read_file(path)
    u64 new_content = content
    if existing != 0 {
        new_content = str_cat(existing, content)
    }
    write_file(path, new_content)
}

// Read a line from stdin (up to max_len bytes)
// Returns allocated string
fn read_line(u64 max_len) -> u64 {
    u64 buf = alloc(max_len + 1)
    u64 i = 0
    u8[1] byte_buf
    while i < max_len {
        file_read(0, byte_buf, 1)
        u64 ch = byte_buf[0]
        if ch == 10 { break }
        if ch == 0 { break }
        u64 p = buf + i
        u8 cb = ch
        store8(p, cb)
        i = i + 1
    }
    u64 tp = buf + i
    u8 z = 0
    store8(tp, z)
    return buf
}

// Print a number followed by newline
fn print_int(u64 val) {
    println(val)
}

// Print a string followed by newline
fn print_line(u64 s) {
    println_str(s)
}

// Print formatted: "name = value\n"
// key is a string pointer (from a variable or literal), val is an integer
fn print_kv(u64 key, u64 val) {
    print_str(key)
    print(" = ")
    println(val)
}

// Print N spaces (indentation)
fn print_indent(u64 n) {
    u64 i = 0
    while i < n {
        print(" ")
        i = i + 1
    }
}

// Read an integer from stdin (reads one line, parses as int)
// Handles optional leading whitespace and negative sign
fn scan_int() -> u64 {
    u64 buf = alloc(65)
    u64 i = 0
    u8[1] byte_buf
    while i < 64 {
        file_read(0, byte_buf, 1)
        u64 ch = byte_buf[0]
        if ch == 10 { break }
        if ch == 13 { break }
        if ch == 0 { break }
        u64 p = buf + i
        u8 cb = ch
        store8(p, cb)
        i = i + 1
    }
    u64 tp = buf + i
    u8 z = 0
    store8(tp, z)
    // Parse integer
    u64 result = 0
    u64 pos = 0
    u64 neg = 0
    u64 p2 = buf
    u64 c = 0
    c = load8(p2)
    // Skip leading whitespace
    while c == 32 || c == 9 {
        pos = pos + 1
        p2 = buf + pos
        c = load8(p2)
    }
    if c == 45 { neg = 1; pos = pos + 1 }
    p2 = buf + pos
    c = load8(p2)
    while c >= 48 && c <= 57 {
        result = result * 10 + c - 48
        pos = pos + 1
        p2 = buf + pos
        c = load8(p2)
    }
    if neg != 0 { return 0 - result }
    return result
}

// Read a string from stdin (reads one line, max 1024 bytes)
fn scan_str() -> u64 {
    return read_line(1024)
}

// ---------------------------------------------------------------------------
// Syscall-errno helpers — see docs/ERROR_HANDLING.md Pattern 2.
//
// Linux syscalls that fail return -errno in two's complement. Cast as u64
// that's a value in the window 0xFFFFFFFFFFFFF000..0xFFFFFFFFFFFFFFFF
// (errno values are always < 4096, largest Linux errno is EHWPOISON = 133).
// ---------------------------------------------------------------------------

// 1 if `r` looks like a kernel error code, 0 otherwise.
fn is_errno(u64 r) -> u64 {
    if r > 0xFFFFFFFFFFFFF000 { return 1 }
    return 0
}

// Return the positive errno value if `r` is an error, else 0.
fn get_errno(u64 r) -> u64 {
    if is_errno(r) != 0 { return 0 - r }
    return 0
}

// ---------------------------------------------------------------------------
// Portable read-only whole-file loading (map-or-read)
//
// Syscall 9 is mmap and syscall 11 is munmap on **Linux x86_64 only**. Other
// Linux architectures number their tables differently: aarch64 uses the
// asm-generic table, where mmap is 222 and munmap is 215, and where 9 is
// lgetxattr and 11 is removexattr. Code that hardcoded 9/11 therefore failed
// on ARM64 with a misleading "mmap failed", and x86_64 CI never saw it.
//
// What makes this portable is NOT a syscall-number table — there is no way to
// verify one here — it is the fallback. The mmap is attempted exactly as
// before, and if (and only if) it errors, the file is read into an alloc()'d
// buffer through the compiler's portable file_open/file_read builtins. On
// x86_64 the mmap succeeds and the old path is unchanged; on aarch64, and on
// any host that refuses the mapping for an unrelated reason, the read path
// produces a byte-identical buffer at the cost of one copy.
//
// Deliberately NOT done: selecting the syscall number by architecture at
// runtime. Falling back from 9 to 222 would invoke io_setup with mmap's
// arguments on x86_64, which is a real side effect.
//
// The two kinds of region must be released differently — munmap for the
// mapping, dealloc for the buffer — and a caller holding only `base` cannot
// tell them apart. Rather than add a discriminator field to every file handle
// struct (GGUFFile is already at the hard 16-u64-field ceiling documented at
// gguf.mlr:109, so it *cannot* take one), every region handed out is recorded
// below with the mode used to obtain it, and mlr_unmap_file looks the mode up.
//
// This lives in io.mlr because every module that loads a file this way
// (tokenizer, gguf, bpe_train, wzma_data, safetensors) already imports io.mlr,
// so routing them through it adds no new dependency edge anywhere — and in
// particular cannot drag the x86_64-only std/thread.mlr into the LLM drivers.
// ---------------------------------------------------------------------------

static u64 MLR_MAP_MODE_MMAP  = 1   // released with munmap (syscall 11)
static u64 MLR_MAP_MODE_ALLOC = 2   // released with dealloc

// Registry of regions currently owned by callers of mlr_map_file. 16 bytes per
// slot: base(8) + mode(8). base == 0 marks a free slot. Allocated lazily and
// grown by doubling, so there is no fixed ceiling on live regions.
//
// THREADING: main thread only, and (for the lazy init and the growth realloc)
// before any worker is spawned. This registry is process-global mutable state
// with an UNSYNCHRONIZED lazy init, and std/thread.mlr clones with CLONE_VM —
// workers share this memory. Two threads entering _mlr_map_reg_record with
// _mlr_map_reg_cap == 0 would both allocate and one table would be leaked and
// silently ignored, which is exactly the shape of the old bpe_count_words
// shared-scratch bug. There is no lock in MLRift to take here.
//
// That constraint holds today by construction, not by luck: no worker entry
// point in std/ (bpe_wc_worker, mm_worker_*, vec_mt_*, _hipkfd_h2d_worker)
// does file I/O, and wordcount_smoke's bpe_munmap_file runs after
// thread_pool_wait. _mlr_map_busy below is a best-effort detector so that a
// future caller which breaks the rule fails loudly instead of corrupting the
// table. It is NOT a lock and NOT thread-safety: it is the same re-entry
// assertion as bpe_wc_in_flight (std/bpe_train.mlr), and it catches recursive
// re-entry reliably and a genuine concurrent entry only most of the time. It
// costs one load and compare per whole-file map/unmap — never on a hot path.
static u64 _mlr_map_reg     = 0
static u64 _mlr_map_reg_cap = 0
static u64 _mlr_map_busy    = 0

fn _mlr_map_reg_enter(u64 who) {
    if _mlr_map_busy == 1 {
        print("[mlr_map_file] region registry re-entered during ")
        println_str(who)
        print("[mlr_map_file] it is main-thread-only; see the THREADING note in std/io.mlr\n")
        exit(1)
    }
    _mlr_map_busy = 1
}

fn _mlr_map_reg_record(u64 base, u64 mode) {
    _mlr_map_reg_enter("record")
    if _mlr_map_reg_cap == 0 {
        u64 reg0 = alloc(16 * 16)
        if reg0 == 0 {
            print("[mlr_map_file] out of memory allocating the region registry\n")
            exit(1)
        }
        memset(reg0, 0, 16 * 16)
        _mlr_map_reg = reg0
        _mlr_map_reg_cap = 16
    }
    u64 i = 0
    while i < _mlr_map_reg_cap {
        if load64(_mlr_map_reg + i * 16) == 0 {
            store64(_mlr_map_reg + i * 16, base)
            store64(_mlr_map_reg + i * 16 + 8, mode)
            _mlr_map_busy = 0
            return
        }
        i = i + 1
    }
    // Full: double and retry into the fresh half.
    u64 ncap = _mlr_map_reg_cap * 2
    u64 nreg = alloc(ncap * 16)
    if nreg == 0 {
        // Without this the memset/memcpy below would run through a null
        // pointer and segfault instead of reporting the real problem.
        print("[mlr_map_file] out of memory growing the region registry to ")
        print(ncap)
        print(" slots\n")
        exit(1)
    }
    memset(nreg, 0, ncap * 16)
    memcpy(nreg, _mlr_map_reg, _mlr_map_reg_cap * 16)
    dealloc(_mlr_map_reg)
    store64(nreg + _mlr_map_reg_cap * 16, base)
    store64(nreg + _mlr_map_reg_cap * 16 + 8, mode)
    _mlr_map_reg = nreg
    _mlr_map_reg_cap = ncap
    _mlr_map_busy = 0
}

// Look up how `base` was obtained and free its slot. Returns the mode, or 0
// if `base` was never handed out by mlr_map_file (or was already released).
fn _mlr_map_reg_take(u64 base) -> u64 {
    _mlr_map_reg_enter("take")
    u64 i = 0
    while i < _mlr_map_reg_cap {
        if load64(_mlr_map_reg + i * 16) == base {
            u64 mode = load64(_mlr_map_reg + i * 16 + 8)
            store64(_mlr_map_reg + i * 16, 0)
            store64(_mlr_map_reg + i * 16 + 8, 0)
            _mlr_map_busy = 0
            return mode
        }
        i = i + 1
    }
    _mlr_map_busy = 0
    return 0
}

// Load `path` read-only in its entirety. Writes the byte count to *out_size
// and returns the base of a readable region holding the whole file, or returns
// 0 (with *out_size := 0) on any failure, having printed the precise reason.
// The region MUST be released with mlr_unmap_file, which knows which of the
// two kinds it is.
//
// A zero-length file is reported as a failure. mmap with length 0 is EINVAL,
// so that is what every caller has always seen; the read path would instead
// hand back a 0-byte buffer and change what a caller's `base == 0` check
// means, so both paths answer the old way.
fn mlr_map_file(u64 path, u64 out_size) -> u64 {
    store64(out_size, 0)

    u64 fd = file_open(path, 0)
    if is_errno(fd) != 0 {
        print("[mlr_map_file] open failed (errno ")
        print(get_errno(fd))
        print(") on ")
        println_str(path)
        return 0
    }

    // fstat can fail (EBADF, EIO, an overflowing st_size on a 32-bit stat).
    // Unchecked, the error code is a huge unsigned value that would be passed
    // straight to alloc() and reported as a bogus out-of-memory.
    u64 sz = file_size(fd)
    if is_errno(sz) != 0 {
        print("[mlr_map_file] stat failed (errno ")
        print(get_errno(sz))
        print(") on ")
        println_str(path)
        file_close(fd)
        return 0
    }
    if sz == 0 {
        print("[mlr_map_file] empty file: ")
        println_str(path)
        file_close(fd)
        return 0
    }

    // mmap(NULL, sz, PROT_READ=1, MAP_PRIVATE=2, fd, 0) — x86_64 numbering.
    u64 base = syscall_raw(9, 0, sz, 1, 2, fd, 0)
    if is_errno(base) == 0 {
        file_close(fd)
        _mlr_map_reg_record(base, MLR_MAP_MODE_MMAP)
        store64(out_size, sz)
        return base
    }

    // Fallback: read the whole file into an alloc()'d buffer.
    u64 buf = alloc(sz)
    if buf == 0 {
        print("[mlr_map_file] out of memory reserving ")
        print(sz)
        print(" bytes for ")
        println_str(path)
        file_close(fd)
        return 0
    }
    // file_read lowers to a SINGLE read(2) with no loop of its own
    // (src/codegen.mlr), so a large file short-reads. This loop is what makes
    // the buffer complete; without it the tail would be uninitialized.
    u64 got = 0
    u64 eintr_run = 0
    u64 failed = 0
    while got < sz {
        u64 n = file_read(fd, buf + got, sz - got)
        if is_errno(n) != 0 {
            // EINTR (4) means a signal arrived mid-read and nothing was
            // consumed; the correct response is to reissue the read, not to
            // fail the load. Every other errno stays fatal and loud. The
            // consecutive-EINTR cap keeps a pathological signal storm from
            // spinning here forever instead of failing.
            if get_errno(n) == 4 {
                eintr_run = eintr_run + 1
                if eintr_run > 1024 {
                    print("[mlr_map_file] read interrupted repeatedly (EINTR, ")
                    print(eintr_run)
                    print(" consecutive) after ")
                    print(got)
                    print(" of ")
                    print(sz)
                    print(" bytes on ")
                    println_str(path)
                    failed = 1
                    break
                }
                continue
            }
            print("[mlr_map_file] read failed (errno ")
            print(get_errno(n))
            print(") after ")
            print(got)
            print(" of ")
            print(sz)
            print(" bytes on ")
            println_str(path)
            failed = 1
            break
        }
        if n == 0 { break }        // premature EOF — reported as a short read below
        eintr_run = 0
        got = got + n
    }
    file_close(fd)
    // Two distinct failures, each reporting its own cause. `failed` means the
    // loop already printed the specific errno (or the EINTR cap) it died on;
    // adding the short-read line there would misreport a genuine I/O error as
    // a truncated file. A short read with failed == 0 is the other case: the
    // reads succeeded but the file ended early.
    if failed != 0 {
        dealloc(buf)
        return 0
    }
    if got != sz {
        // Loud, not silent: a partially filled buffer would be parsed as real
        // content rather than reported as an error.
        print("[mlr_map_file] mmap unavailable and short read on ")
        print_str(path)
        print(" (got ")
        print(got)
        print(" of ")
        print(sz)
        print(" bytes)\n")
        dealloc(buf)
        return 0
    }
    _mlr_map_reg_record(buf, MLR_MAP_MODE_ALLOC)
    store64(out_size, sz)
    return buf
}

// Release a region obtained from mlr_map_file, using whichever of munmap /
// dealloc matches how it was obtained. `size` is ignored on the alloc path.
fn mlr_unmap_file(u64 base, u64 size) {
    if base == 0 { return }
    u64 mode = _mlr_map_reg_take(base)
    if mode == MLR_MAP_MODE_ALLOC {
        dealloc(base)
        return
    }
    if mode == 0 {
        // Not in the registry: either already released, or never came from
        // mlr_map_file. Both are caller bugs, and guessing munmap on an
        // alloc()'d or already-freed pointer is worse than stopping.
        print("[mlr_unmap_file] unknown region — double free?\n")
        exit(1)
    }
    u64 r = syscall_raw(11, base, size, 0, 0, 0, 0)   // munmap
    if is_errno(r) != 0 {
        print("[mlr_unmap_file] munmap failed (errno ")
        print(get_errno(r))
        print(")\n")
        exit(1)
    }
}
