import "io.mlr"
import "string.mlr"
import "bpe_unicode.mlr"

static u64 bpe_b2c = 0        // u32[256] byte -> codepoint
static u64 bpe_b2c_init = 0

fn bpe_b2c_ensure() {
    if bpe_b2c_init == 1 { return }
    bpe_b2c = alloc(256 * 4)
    u64 b = 0
    u64 n = 0                 // counter for the "other" remap into 0x100+
    while b < 256 {
        // printable set: 0x21..0x7E, 0xA1..0xAC, 0xAE..0xFF map to themselves
        u64 printable = 0
        if b >= 0x21 && b <= 0x7E { printable = 1 }
        if b >= 0xA1 && b <= 0xAC { printable = 1 }
        if b >= 0xAE && b <= 0xFF { printable = 1 }
        u32 cp = 0
        if printable == 1 { cp = b } else { cp = 0x100 + n; n = n + 1 }
        store32(bpe_b2c + b*4, cp)
        b = b + 1
    }
    bpe_b2c_init = 1
}

fn bpe_utf8_encode_cp(u64 dst, u64 cp) -> u64 {
    if cp < 0x80 { store8(dst, cp); return 1 }
    if cp < 0x800 {
        store8(dst,   0xC0 | (cp >> 6))
        store8(dst+1, 0x80 | (cp & 0x3F)); return 2 }
    if cp < 0x10000 {
        store8(dst,   0xE0 | (cp >> 12))
        store8(dst+1, 0x80 | ((cp >> 6) & 0x3F))
        store8(dst+2, 0x80 | (cp & 0x3F)); return 3 }
    store8(dst,   0xF0 | (cp >> 18))
    store8(dst+1, 0x80 | ((cp >> 12) & 0x3F))
    store8(dst+2, 0x80 | ((cp >> 6) & 0x3F))
    store8(dst+3, 0x80 | (cp & 0x3F)); return 4
}

fn bpe_byte_map_piece(u64 src, u64 slen, u64 dst) -> u64 {
    bpe_b2c_ensure()
    u64 i = 0; u64 o = 0
    while i < slen {
        u64 bb = 0; unsafe { *((src + i) as u8) -> bb }      // zero-extend load
        u64 cp = 0; unsafe { *((bpe_b2c + bb*4) as u32) -> cp }
        o = o + bpe_utf8_encode_cp(dst + o, cp)
        i = i + 1
    }
    return o
}

// NOTE: NO `expr as uNN` value casts anywhere — they do not parse in MLRift
// (`(b as u64)` is a parse error). Load bytes straight into u64 locals with a
// typed unsafe load (zero-extends), which is the in-tree idiom.
fn bpe_utf8_decode(u64 p, u64 end, u64 out_cp) -> u64 {
    if p >= end { return 0 }
    u64 c0 = 0; unsafe { *(p as u8) -> c0 }
    if c0 < 0x80 { store64(out_cp, c0); return 1 }
    // R-T1: stray continuation byte (0x80-0xBF) or an overlong/invalid lead
    // (0xC0-0xC1, which can only ever overlong-encode 0x00-0x7F) — lenient
    // single-byte fallback so offsets stay sane on malformed input instead
    // of silently mis-decoding/mis-splitting. Never hit on valid UTF-8.
    if c0 <= 0xC1 { store64(out_cp, c0); return 1 }
    if c0 >= 0xF0 {
        if p + 4 > end { store64(out_cp, c0); return 1 }
        u64 b1=0; u64 b2=0; u64 b3=0
        unsafe { *((p+1) as u8) -> b1 } unsafe { *((p+2) as u8) -> b2 } unsafe { *((p+3) as u8) -> b3 }
        if b1 < 0x80 || b1 > 0xBF || b2 < 0x80 || b2 > 0xBF || b3 < 0x80 || b3 > 0xBF {
            store64(out_cp, c0); return 1 }
        u64 cp = ((c0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
        store64(out_cp, cp); return 4 }
    if c0 >= 0xE0 {
        if p + 3 > end { store64(out_cp, c0); return 1 }
        u64 b1=0; u64 b2=0
        unsafe { *((p+1) as u8) -> b1 } unsafe { *((p+2) as u8) -> b2 }
        if b1 < 0x80 || b1 > 0xBF || b2 < 0x80 || b2 > 0xBF {
            store64(out_cp, c0); return 1 }
        u64 cp = ((c0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
        store64(out_cp, cp); return 3 }
    // remaining range is 0xC2..0xDF: a valid 2-byte lead.
    if p + 2 > end { store64(out_cp, c0); return 1 }
    u64 b1=0; unsafe { *((p+1) as u8) -> b1 }
    if b1 < 0x80 || b1 > 0xBF { store64(out_cp, c0); return 1 }
    u64 cp = ((c0 & 0x1F) << 6) | (b1 & 0x3F)
    store64(out_cp, cp); return 2
}

// ---------------------------------------------------------------------------
// Exact GPT-2 ByteLevel pre-tokenizer
//
//   's|'t|'re|'ve|'m|'ll|'d | ?\p{L}+ | ?\p{N}+ | ?[^\s\p{L}\p{N}]+ | \s+(?!\S) | \s+
//
// matched leftmost with ORDERED alternation at every cursor position.
//
// ORDER MATTERS: the RAW (decoded UTF-8) text is split FIRST and each piece is
// byte-mapped afterwards by the caller. Splitting byte-mapped text is wrong —
// the map turns 0xA9 into "©" (a symbol), which would tear "café" in two.
// ---------------------------------------------------------------------------

// \p{White_Space}
fn bpe_cp_is_ws(u64 cp) -> u64 {
    if cp == 0x20 { return 1 }
    if cp >= 0x09 && cp <= 0x0D { return 1 }
    if cp == 0x85 || cp == 0xA0 || cp == 0x1680 { return 1 }
    if cp >= 0x2000 && cp <= 0x200A { return 1 }
    if cp == 0x2028 || cp == 0x2029 || cp == 0x202F || cp == 0x205F || cp == 0x3000 { return 1 }
    return 0
}

// Fills offs[i]/lens[i] with each pre-token's offset+length in the ORIGINAL
// bytes of `text`; returns the piece count.
fn bpe_pretok_split(u64 text, u64 len, u64 offs, u64 lens, u64 max) -> u64 {
    u64 pos = 0
    u64 np = 0
    u64 cpbuf = alloc(8)
    while pos < len {
        u64 start = pos
        u64 c = 0
        unsafe { *((text + pos) as u8) -> c }
        u64 matched = 0

        // --- contractions: tried ONLY at a bare ' (no leading space), lowercase
        if c == 0x27 {
            u64 n1 = 0
            u64 has1 = 0
            if pos + 1 < len {
                unsafe { *((text + pos + 1) as u8) -> n1 }
                has1 = 1
            }
            u64 n2 = 0
            u64 has2 = 0
            if pos + 2 < len {
                unsafe { *((text + pos + 2) as u8) -> n2 }
                has2 = 1
            }
            // 2-byte: 's 't 'm 'd
            if has1 == 1 && (n1 == 0x73 || n1 == 0x74 || n1 == 0x6D || n1 == 0x64) {
                pos = pos + 2
                matched = 1
            }
            // 3-byte: 're 've 'll — BOTH trailing bytes must match
            if matched == 0 && has2 == 1 {
                if n1 == 0x72 && n2 == 0x65 {
                    pos = pos + 3
                    matched = 1
                }
                if n1 == 0x76 && n2 == 0x65 {
                    pos = pos + 3
                    matched = 1
                }
                if n1 == 0x6C && n2 == 0x6C {
                    pos = pos + 3
                    matched = 1
                }
            }
            // no match (e.g. "'r", a trailing ') → branch C eats the bare '
        }

        if matched == 0 {
            u64 cp0 = 0
            bpe_utf8_decode(text + pos, text + len, cpbuf)
            unsafe { *(cpbuf as u64) -> cp0 }

            // exactly ONE optional leading 0x20 (no other whitespace attaches)
            u64 lead_space = 0
            if cp0 == 0x20 { lead_space = 1 }

            // class the codepoint AFTER the optional space. have1 == 0 means
            // "there is no codepoint there" (EOF) — kept distinct from cp == 0.
            u64 cp1 = cp0
            u64 first = pos
            u64 have1 = 1
            if lead_space == 1 {
                first = pos + 1
                if first < len {
                    bpe_utf8_decode(text + first, text + len, cpbuf)
                    unsafe { *(cpbuf as u64) -> cp1 }
                } else {
                    have1 = 0
                }
            }

            // Branch A: ` ?\p{L}+`
            if have1 == 1 && uni_is_letter(cp1) == 1 {
                pos = first
                while pos < len {
                    u64 cpa = 0
                    u64 ua = bpe_utf8_decode(text + pos, text + len, cpbuf)
                    unsafe { *(cpbuf as u64) -> cpa }
                    if uni_is_letter(cpa) == 1 { pos = pos + ua } else { break }
                }
                matched = 1
            }

            // Branch B: ` ?\p{N}+`
            if matched == 0 && have1 == 1 && uni_is_number(cp1) == 1 {
                pos = first
                while pos < len {
                    u64 cpb = 0
                    u64 ub = bpe_utf8_decode(text + pos, text + len, cpbuf)
                    unsafe { *(cpbuf as u64) -> cpb }
                    if uni_is_number(cpb) == 1 { pos = pos + ub } else { break }
                }
                matched = 1
            }

            // Branch C: ` ?[^\s\p{L}\p{N}]+`
            if matched == 0 && have1 == 1 && bpe_cp_is_ws(cp1) == 0 && uni_is_letter(cp1) == 0 && uni_is_number(cp1) == 0 {
                pos = first
                while pos < len {
                    u64 cpc = 0
                    u64 uc = bpe_utf8_decode(text + pos, text + len, cpbuf)
                    unsafe { *(cpbuf as u64) -> cpc }
                    if bpe_cp_is_ws(cpc) == 0 && uni_is_letter(cpc) == 0 && uni_is_number(cpc) == 0 {
                        pos = pos + uc
                    } else {
                        break
                    }
                }
                matched = 1
            }

            // Branch D/E: `\s+(?!\S)` then `\s+`
            if matched == 0 && bpe_cp_is_ws(cp0) == 1 {
                u64 runend = pos
                while runend < len {
                    u64 cpd = 0
                    u64 ud = bpe_utf8_decode(text + runend, text + len, cpbuf)
                    unsafe { *(cpbuf as u64) -> cpd }
                    if bpe_cp_is_ws(cpd) == 1 { runend = runend + ud } else { break }
                }
                if runend < len {
                    // a non-space follows: \s+(?!\S) takes all but the LAST
                    // whitespace codepoint; that one leads the next token.
                    u64 prev = pos
                    u64 q = pos
                    while q < runend {
                        u64 uq = bpe_utf8_decode(text + q, text + len, cpbuf)
                        prev = q
                        q = q + uq
                    }
                    if prev > pos { pos = prev } else { pos = runend }
                } else {
                    // the run reaches EOF: plain \s+ takes the whole run
                    pos = runend
                }
                matched = 1
            }
        }

        if pos <= start { pos = start + 1 }        // safety: never stall
        if np >= max {
            print("bpe_pretok_split: piece overflow\n")
            exit(1)
        }
        store64(offs + np * 8, start)
        store64(lens + np * 8, pos - start)
        np = np + 1
    }
    dealloc(cpbuf)
    return np
}

// ---------------------------------------------------------------------------
// Task 3: single-thread word-frequency counter.
//
// Kept dependency-light on purpose (controller ruling): NO import of
// tokenizer.mlr or wzma_data.mlr — both a local FNV-1a 64 and a local mmap
// helper are implemented right here instead of reusing tk_fnv1a /
// wzma_data_open, so this file's only imports stay io.mlr, string.mlr,
// bpe_unicode.mlr.
// ---------------------------------------------------------------------------

// Standard FNV-1a, 64-bit (offset basis 0xcbf29ce484222325, prime
// 0x100000001b3), byte-wise. u64 multiply/xor wrap mod 2^64 already, so no
// masking is needed (unlike the 32-bit tk_fnv1a in tokenizer.mlr).
fn bpe_fnv1a(u64 ptr, u64 len) -> u64 {
    u64 h = 0xCBF29CE484222325
    u64 i = 0
    while i < len {
        u64 b = load8(ptr + i)
        h = h ^ b
        h = h * 0x100000001B3
        i = i + 1
    }
    return h
}

// mmap a file read-only. Writes its size to *out_size and returns the mmap
// base, or returns 0 (out_size := 0) on any failure. Mechanics copied from
// wzma_data_open (std/wzma_data.mlr) without importing that file.
fn bpe_mmap_file(u64 path, u64 out_size) -> u64 {
    u64 fd = file_open(path, 0)
    if is_errno(fd) != 0 {
        store64(out_size, 0)
        return 0
    }
    u64 sz = file_size(fd)
    // mmap PROT_READ (1) MAP_PRIVATE (2)
    u64 base = syscall_raw(9, 0, sz, 1, 2, fd, 0)
    if is_errno(base) != 0 {
        file_close(fd)
        store64(out_size, 0)
        return 0
    }
    file_close(fd)
    store64(out_size, sz)
    return base
}

fn bpe_bytes_eq(u64 a, u64 b, u64 len) -> u64 {
    u64 i = 0
    while i < len {
        if load8(a + i) != load8(b + i) { return 0 }
        i = i + 1
    }
    return 1
}

// ---------------------------------------------------------------------------
// WordTable — open-addressed hash of byte-mapped word bytes -> u64 freq,
// with a stable insertion index for deterministic iteration.
//
// Design: the hash table only maps hash -> entry index (for lookup); the
// actual (blob offset, length, freq) triples live in a separate `entries`
// array in pure insertion order, so iteration by index (bpe_wt_word) never
// needs a stored "index" field or a search — entries[i] IS the i-th
// inserted word. Growing the hash table (rehash at 0.7 load) only touches
// the `slots` array; entries and the string blob are untouched by it.
//
// Header (64 bytes), all u64 fields:
//   +0  cap          hash-slot capacity (power of two)
//   +8  count        number of distinct words == entries used
//   +16 slots_ptr    array of cap slots, 24B each: used(8)+hash(8)+entry_idx(8)
//   +24 entries_ptr  array of entries, 24B each: blob_off(8)+len(8)+freq(8)
//   +32 entries_cap  allocated capacity (in entries) of entries_ptr
//   +40 blob_ptr     growable byte blob holding word bytes
//   +48 blob_len     bytes used in the blob
//   +56 blob_cap     bytes allocated for the blob
// ---------------------------------------------------------------------------

fn bpe_wt_next_pow2(u64 n) -> u64 {
    u64 p = 8
    while p < n { p = p * 2 }
    return p
}

fn bpe_wt_new(u64 cap) -> u64 {
    u64 wt = alloc(64)
    u64 c = bpe_wt_next_pow2(cap)
    store64(wt, c)          // cap
    store64(wt + 8, 0)      // count

    u64 slots = alloc(c * 24)
    memset(slots, 0, c * 24)
    store64(wt + 16, slots)

    u64 ecap = c
    u64 entries = alloc(ecap * 24)
    memset(entries, 0, ecap * 24)
    store64(wt + 24, entries)
    store64(wt + 32, ecap)

    u64 bcap = c * 8
    if bcap < 4096 { bcap = 4096 }
    u64 blob = alloc(bcap)
    store64(wt + 40, blob)
    store64(wt + 48, 0)
    store64(wt + 56, bcap)

    return wt
}

fn bpe_wt_count(u64 wt) -> u64 {
    return load64(wt + 8)
}

// Writes the i-th (in insertion order) word's blob pointer to *out_ptr and
// its length to *out_len. Returns its freq.
fn bpe_wt_word(u64 wt, u64 i, u64 out_ptr, u64 out_len) -> u64 {
    if i >= load64(wt + 8) {
        print("bpe_wt_word: index out of range\n")
        exit(1)
    }
    u64 entries = load64(wt + 24)
    u64 entry = entries + i * 24
    u64 off = load64(entry)
    u64 len = load64(entry + 8)
    u64 freq = load64(entry + 16)
    u64 blob = load64(wt + 40)
    store64(out_ptr, blob + off)
    store64(out_len, len)
    return freq
}

// Rehash the hash-slot array into a doubled table. entries/blob untouched —
// only the (hash -> entry_idx) placement changes, so all indices, offsets
// and freqs are preserved exactly (iteration order stays stable).
fn bpe_wt_grow_slots(u64 wt) {
    u64 cap = load64(wt)
    u64 slots = load64(wt + 16)
    u64 new_cap = cap * 2
    u64 new_slots = alloc(new_cap * 24)
    memset(new_slots, 0, new_cap * 24)

    u64 i = 0
    while i < cap {
        u64 slot = slots + i * 24
        if load64(slot) == 1 {
            u64 hash = load64(slot + 8)
            u64 idx = load64(slot + 16)
            u64 j = hash & (new_cap - 1)
            while load64(new_slots + j * 24) != 0 {
                j = (j + 1) & (new_cap - 1)
            }
            store64(new_slots + j * 24, 1)
            store64(new_slots + j * 24 + 8, hash)
            store64(new_slots + j * 24 + 16, idx)
        }
        i = i + 1
    }
    dealloc(slots)
    store64(wt, new_cap)
    store64(wt + 16, new_slots)
}

fn bpe_wt_grow_entries(u64 wt) {
    u64 ecap = load64(wt + 32)
    u64 entries = load64(wt + 24)
    u64 new_ecap = ecap * 2
    u64 new_entries = alloc(new_ecap * 24)
    memset(new_entries, 0, new_ecap * 24)
    u64 count = load64(wt + 8)
    memcpy(new_entries, entries, count * 24)
    dealloc(entries)
    store64(wt + 24, new_entries)
    store64(wt + 32, new_ecap)
}

fn bpe_wt_ensure_blob(u64 wt, u64 need) {
    u64 blen = load64(wt + 48)
    u64 bcap = load64(wt + 56)
    if blen + need <= bcap { return }
    u64 new_cap = bcap * 2
    while new_cap < blen + need { new_cap = new_cap * 2 }
    u64 blob = load64(wt + 40)
    u64 new_blob = alloc(new_cap)
    memcpy(new_blob, blob, blen)
    dealloc(blob)
    store64(wt + 40, new_blob)
    store64(wt + 56, new_cap)
}

// Adds `add` to an existing word's freq, or inserts it (freq := add) if not
// present. `s`/`slen` must already be byte-mapped bytes.
fn bpe_wt_add(u64 wt, u64 s, u64 slen, u64 add) {
    u64 hash = bpe_fnv1a(s, slen)

    // Grow (rehash) BEFORE probing if this insert could push load >= 0.7 —
    // guarantees the probe loop below always finds an empty slot.
    u64 count = load64(wt + 8)
    u64 cap = load64(wt)
    if (count + 1) * 10 >= cap * 7 {
        bpe_wt_grow_slots(wt)
        cap = load64(wt)
    }

    u64 slots = load64(wt + 16)
    u64 i = hash & (cap - 1)
    while 1 {
        u64 slot = slots + i * 24
        u64 used = load64(slot)
        if used == 0 {
            // New word: append its bytes to the blob, append a new entry,
            // and record the (hash -> entry_idx) mapping in this slot.
            u64 idx = load64(wt + 8)
            if idx >= load64(wt + 32) {
                bpe_wt_grow_entries(wt)
            }
            bpe_wt_ensure_blob(wt, slen)

            u64 blob = load64(wt + 40)
            u64 blen = load64(wt + 48)
            memcpy(blob + blen, s, slen)
            store64(wt + 48, blen + slen)

            u64 entries = load64(wt + 24)
            u64 entry = entries + idx * 24
            store64(entry, blen)
            store64(entry + 8, slen)
            store64(entry + 16, add)

            store64(slot, 1)
            store64(slot + 8, hash)
            store64(slot + 16, idx)

            store64(wt + 8, idx + 1)
            return
        }

        u64 ehash = load64(slot + 8)
        if ehash == hash {
            u64 eidx = load64(slot + 16)
            u64 entries2 = load64(wt + 24)
            u64 entry2 = entries2 + eidx * 24
            u64 elen = load64(entry2 + 8)
            if elen == slen {
                u64 eoff = load64(entry2)
                u64 blob2 = load64(wt + 40)
                if bpe_bytes_eq(blob2 + eoff, s, slen) == 1 {
                    store64(entry2 + 16, load64(entry2 + 16) + add)
                    return
                }
            }
        }
        i = (i + 1) & (cap - 1)
    }
}

// M-4: release everything owned by a WordTable (slots, entries, blob, the
// header itself). The caller still owns `wt`'s corpus buffer separately.
fn bpe_wt_free(u64 wt) {
    dealloc(load64(wt + 16))   // slots
    dealloc(load64(wt + 24))   // entries
    dealloc(load64(wt + 40))   // blob
    dealloc(wt)
}

// M-4: munmap a region returned by bpe_mmap_file.
fn bpe_munmap_file(u64 base, u64 size) {
    syscall_raw(11, base, size, 0, 0, 0, 0)
}

// Hard ceiling on a single corpus LINE (including its trailing '\n') this
// counter will handle — a backstop, not the normal sizing source (see
// bpe_cw_max_line_len / M-5 below). A longer line dies loud rather than
// silently truncating/corrupting.
//
// M-6: constant-by-convention. MLRift has no `const`, only `static`
// (mutable) globals, so this relies on discipline: nothing in this file (or
// any importer) may ever assign to BPE_CW_LINE_CAP after module init.
static u64 BPE_CW_LINE_CAP = 1048576

// One pass over the corpus using the exact same line-splitting rule as
// bpe_count_words_1t below, to find the longest line (including its
// trailing '\n'). Lets the counter size its scratch buffers from the real
// corpus instead of always paying for a fixed multi-MiB guess — Task 6
// parallelizes bpe_count_words_1t N-way, and N x a fixed ~18 MiB/call would
// be wasted memory for no benefit.
fn bpe_cw_max_line_len(u64 corpus_base, u64 corpus_size) -> u64 {
    u64 max_len = 0
    u64 pos = 0
    while pos < corpus_size {
        u64 line_start = pos
        u64 nl = pos
        while nl < corpus_size {
            if load8(corpus_base + nl) == 10 { break }   // '\n'
            nl = nl + 1
        }
        u64 line_end = nl
        if nl < corpus_size { line_end = nl + 1 }        // keep the '\n'
        u64 line_len = line_end - line_start
        if line_len > max_len { max_len = line_len }
        pos = line_end
    }
    return max_len
}

// Count word (byte-mapped pre-token) frequencies over the whole corpus.
//
// CRITICAL: iterates LINES, feeding each line INCLUDING its trailing '\n'
// to bpe_pretok_split ONE LINE AT A TIME — never the whole buffer. HF
// trains on lines-with-ending; whole-buffer splitting would fuse adjacent
// blank lines into "ĊĊ" tokens HF never emits (empirically verified by a
// Fable review), which would fail the project's byte-exact gate.
fn bpe_count_words_1t(u64 corpus_base, u64 corpus_size) -> u64 {
    u64 wt = bpe_wt_new(4096)

    // M-5: size scratch buffers from the corpus's actual longest line, not
    // a fixed BPE_CW_LINE_CAP guess; the ceiling stays as a loud-death
    // backstop for a pathological single line.
    u64 line_cap = bpe_cw_max_line_len(corpus_base, corpus_size)
    if line_cap > BPE_CW_LINE_CAP {
        print("bpe_count_words_1t: line too long\n")
        exit(1)
    }
    if line_cap < 1 { line_cap = 1 }   // keep allocs non-zero for an empty corpus
    u64 max_pieces = line_cap + 1
    u64 offs = alloc(max_pieces * 8)
    u64 lens = alloc(max_pieces * 8)
    u64 mapped = alloc(line_cap * 2 + 16)

    u64 pos = 0
    while pos < corpus_size {
        u64 line_start = pos
        u64 nl = pos
        while nl < corpus_size {
            if load8(corpus_base + nl) == 10 { break }   // '\n'
            nl = nl + 1
        }
        u64 line_end = nl
        if nl < corpus_size { line_end = nl + 1 }        // keep the '\n'
        u64 line_len = line_end - line_start

        // M-7: line_len is always >= 1 here — the loop guard `pos <
        // corpus_size` means line_start < corpus_size, and line_end is
        // always line_start+1 or more (either nl+1, or corpus_size when the
        // final line has no trailing '\n', both strictly > line_start). No
        // `if line_len > 0` guard is reachable-false here, so none is used.
        u64 np = bpe_pretok_split(corpus_base + line_start, line_len, offs, lens, line_len + 1)
        u64 k = 0
        while k < np {
            u64 off = load64(offs + k * 8)
            u64 plen = load64(lens + k * 8)
            u64 mlen = bpe_byte_map_piece(corpus_base + line_start + off, plen, mapped)
            bpe_wt_add(wt, mapped, mlen, 1)
            k = k + 1
        }

        // M-7: pos := line_end is always > line_start by the same
        // invariant above, so this loop can never stall — no
        // `if pos <= line_start` safety guard is needed.
        pos = line_end
    }

    dealloc(offs)
    dealloc(lens)
    dealloc(mapped)
    return wt
}
