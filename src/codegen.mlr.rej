--- src/codegen.mlr
+++ src/codegen.mlr
@@ -11450,18 +11523,31 @@ fn gen_stmt(uint64 node) {
         // "use of undeclared identifier" — for `unsafe` just as much as for
         // `volatile`, since both build this node kind.
         uint32 dest_tok = ast_data2(node)
+        // The `as TYPE` clause is the ONLY place the loaded value's register
+        // class is written down — data3 bits 0..3 carry it (1=f64, 2=f32,
+        // 3=f16). The load above already put the right BITS in rax; what was
+        // missing is telling the rest of the function that dest holds a float,
+        // so every later read of it comes out of xmm0. Without it,
+        // `fmt_f64(z)` passed z in a GP register while the callee read xmm0 —
+        // 0.000000000000000 out of memory that held 2.5 exactly.
+        // f16 (3) deliberately stays on the integer path: this language has no
+        // f16 register class, an f16 IS a u64 bit pattern from f32_to_f16(),
+        // and typing it float would break the code that works today.
+        uint32 pl_d3 = ast_data3(node)
+        uint64 wpl_fk = pl_d3
+        wpl_fk = wpl_fk & 15
         uint64 doff = var_lookup(dest_tok)
-        if doff != 0xFFFFFFFF {
-            emit_store_rax_to_stack(doff)
-        } else {
+        if doff == 0xFFFFFFFF {
             uint64 soff = static_lookup(dest_tok)
             if soff != 0xFFFFFFFF {
                 emit_static_store(soff)
-            } else {
-                uint64 ndoff = var_declare(dest_tok)
-                emit_store_rax_to_stack(ndoff)
+                return
             }
+            doff = var_declare(dest_tok)
         }
+        if wpl_fk == 1 { var_type_register(dest_tok, 96) }
+        if wpl_fk == 2 { var_type_register(dest_tok, 95) }
+        emit_store_rax_to_stack(doff)
         return
     }
 
